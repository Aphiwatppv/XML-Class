            dataGridViewEBSO.DataSource = _bsEBSO;
            dataGridViewEBSA.DataSource = _bsEBSA;

            dataGridViewSTEPP.AutoGenerateColumns = true;
            dataGridViewEBSO.AutoGenerateColumns = true;
            dataGridViewEBSA.AutoGenerateColumns = true;

            BuildStatusUI();
            StopProgress("Ready");
        }

        private void BuildStatusUI()
        {
            _statusStrip = new StatusStrip
            {
                SizingGrip = false,
                Dock = DockStyle.Bottom,
                BackColor = Color.FromArgb(25, 25, 25),
                ForeColor = Color.Gainsboro,
                RenderMode = ToolStripRenderMode.System
            };

            _statusText = new ToolStripStatusLabel("Ready")
            {
                Spring = false,
                ForeColor = Color.Gainsboro
            };

            _statusSpacer = new ToolStripStatusLabel
            {
                Spring = true,
                Text = ""
            };

            _statusProgress = new ToolStripProgressBar
            {
                Visible = false,
                Minimum = 0,
                Maximum = 100,
                Value = 0,
                Style = ProgressBarStyle.Continuous,
                AutoSize = false,
                Width = 160
            };

            _statusStrip.Items.Add(_statusText);
            _statusStrip.Items.Add(_statusSpacer);
            _statusStrip.Items.Add(new ToolStripControlHost(new Panel() { Width = 4 }));
            _statusStrip.Items.Add(_statusProgress);

            Controls.Add(_statusStrip);
        }

        // ---------------------------------------------------------------------
        // Thread-safe Status Helpers
        // ---------------------------------------------------------------------
        private void UpdateStatus(string text, bool isError = false)
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => UpdateStatus(text, isError))); return; }
            _statusText.Text = text;
            _statusText.ForeColor = isError ? Color.IndianRed : Color.Gainsboro;
        }

        private void StartProgress(string text = "Working…", bool marquee = true)
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => StartProgress(text, marquee))); return; }
            UpdateStatus(text, false);
            _statusProgress.Visible = true;
            _statusProgress.Value = 0;
            _statusProgress.Style = marquee ? ProgressBarStyle.Marquee : ProgressBarStyle.Continuous;
            _statusProgress.MarqueeAnimationSpeed = marquee ? 30 : 0;
        }

        private void ReportProgress(int percent, string text = null)
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => ReportProgress(percent, text))); return; }
            if (text != null) UpdateStatus(text, false);
            if (_statusProgress.Style != ProgressBarStyle.Continuous)
            {
                _statusProgress.Style = ProgressBarStyle.Continuous;
                _statusProgress.MarqueeAnimationSpeed = 0;
            }
            _statusProgress.Visible = true;
            _statusProgress.Value = Math.Max(_statusProgress.Minimum, Math.Min(percent, _statusProgress.Maximum));
        }

        private void StopProgress(string text = "Ready")
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => StopProgress(text))); return; }
            _statusProgress.Visible = false;
            _statusProgress.MarqueeAnimationSpeed = 0;
            UpdateStatus(text, false);
        }

        // ---------------------------------------------------------------------
        // UI helpers
        // ---------------------------------------------------------------------
        private static string NormalizeLotId(string input) => (input ?? string.Empty).Trim();

        private bool TryGetLotId(out string lotId)
        {
            lotId = NormalizeLotId(textBoxLotId.Text);
            if (string.IsNullOrWhiteSpace(lotId))
            {
                MessageBox.Show(this, "Please enter a Lot ID.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                return false;
            }
            return true;
        }

        private void SetBusyUI(bool busy)
        {
            Cursor = busy ? Cursors.WaitCursor : Cursors.Default;
            buttonInvestigation.Enabled = !busy;
            buttonTestProgramEBSO.Enabled = !busy;
            buttonTestProgramEBSA.Enabled = !busy;

            if (busy) StartProgress("Running…", marquee: true);
            else StopProgress("Ready");
        }

        private void UpdateCurrentOperationLabel(string value)
        {
            _currentOperation = value ?? string.Empty;
            labelCurrentOpr.Text = _currentOperation;
        }

        private static string FindCurrentOperation(IEnumerable<AttributeInfo> attrs)
        {
            var attr = attrs?.FirstOrDefault(a =>
                string.Equals(a.ATTR_NAME, "CURRENT_OPERATION", StringComparison.OrdinalIgnoreCase));
            return attr?.ATTR_VALUE ?? string.Empty;
        }

        private void FillTestProgramLists<T>(IEnumerable<T> rows, Func<T, string> nameSel, Func<T, string> revSel)
        {
            _testPrograms.Clear();
            _testProgramRevisions.Clear();

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var r in rows)
            {
                var name = nameSel(r) ?? string.Empty;
                var rev = revSel(r) ?? string.Empty;
                var key = name + "||" + rev;
                if (seen.Add(key))
                {
                    _testPrograms.Add(name);
                    _testProgramRevisions.Add(rev);
                }
            }
        }

        // ---------------------------------------------------------------------
        // Async operations
        // ---------------------------------------------------------------------
        private async Task QueryRecentLotsSummaryAsync(int take, CancellationToken ct)
        {
            try
            {
                SetBusyUI(true);
                StartProgress($"Loading recent {take} lots…", marquee: true);
                var result = await _engine.EngineGetRecentLotsSummary(take).ConfigureAwait(true);
                _bsSTEPP.DataSource = result?.ToList() ?? new List<object>();
                ReportProgress(100, $"Loaded {(_bsSTEPP.Count)} recent lots.");
                _logSystem.Info($"Loaded recent lots summary (count={_bsSTEPP.Count})");
            }
            catch (OperationCanceledException)
            {
                UpdateStatus("Canceled.", false);
                _logSystem.Warning("QueryRecentLotsSummaryAsync: canceled.");
            }
            catch (Exception ex)
            {
                UpdateStatus("Failed to load recent lots: " + ex.Message, isError: true);
                _logSystem.Error("QueryRecentLotsSummaryAsync failed: " + ex);
                MessageBox.Show(this, "Failed to load recent lots summary.\n" + ex.Message,
                    "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                SetBusyUI(false);
            }
        }

        private async Task InvestigateLotAsync(string lotId, CancellationToken ct)
        {
            try
            {
                SetBusyUI(true);
                StartProgress($"Investigating lot {lotId}…", marquee: true);

                // 1) STEPP / DLS-DLM
                UpdateStatus($"[{lotId}] Loading STEPP data…");
                var stepp = await _engine.EngineGettLotsFromDLSDLM(lotId).ConfigureAwait(true);
                _bsSTEPP.DataSource = stepp?.ToList() ?? new List<object>();
                FillTestProgramLists(stepp ?? Enumerable.Empty<dynamic>(),
                                     r => r.TEST_PROG_NAME,
                                     r => r.TEST_PROG_REVISION);
                ReportProgress(25, $"[{lotId}] STEPP loaded ({_bsSTEPP.Count}).");
                _logSystem.Info($"STEPP data loaded for lot {lotId} (rows={_bsSTEPP.Count})");

                // 2) EBSO
                UpdateStatus($"[{lotId}] Loading EBSO data…");
                var ebso = await _engine.EngineGetDatafromEBSO(lotId).ConfigureAwait(true);
                _bsEBSO.DataSource = ebso?.ToList() ?? new List<object>();
                ReportProgress(50, $"[{lotId}] EBSO loaded ({_bsEBSO.Count}).");
                _logSystem.Info($"EBSO data loaded for lot {lotId} (rows={_bsEBSO.Count})");

                // 3) EBSA
                UpdateStatus($"[{lotId}] Loading EBSA data…");
                var ebsa = await _engine.EngineGetDatafromEBSA(lotId).ConfigureAwait(true);
                _bsEBSA.DataSource = ebsa?.ToList() ?? new List<object>();
                ReportProgress(75, $"[{lotId}] EBSA loaded ({_bsEBSA.Count}).");
                _logSystem.Info($"EBSA data loaded for lot {lotId} (rows={_bsEBSA.Count})");

                // 4) Attributes -> Current Operation
                UpdateStatus($"[{lotId}] Checking attributes…");
                var attrs = await _engine.EngineGetAttributeInfoEBSA(lotId).ConfigureAwait(true);
                var curOp = FindCurrentOperation(attrs ?? Enumerable.Empty<AttributeInfo>());
                UpdateCurrentOperationLabel(curOp);
                ReportProgress(100, $"[{lotId}] Done. Current Operation: {curOp}");
                _logSystem.Info($"Current operation for {lotId}: '{curOp}'");
            }
            catch (OperationCanceledException)
            {
                UpdateStatus("Canceled.", false);
                _logSystem.Warning("InvestigateLotAsync: canceled.");
            }
            catch (Exception ex)
            {
                UpdateStatus($"Error: {ex.Message}", isError: true);
                _logSystem.Error($"InvestigateLotAsync failed for lot {lotId}: {ex}");
                MessageBox.Show(this,
                    $"Investigation failed for lot '{lotId}'.\n{ex.Message}",
                    "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                SetBusyUI(false);
            }
        }

