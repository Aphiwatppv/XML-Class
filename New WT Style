        private async void buttonInvestigation_Click(object sender, EventArgs e)
        {
            if (!TryGetLotId(out var lotId))
                return;

            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            await InvestigateLotAsync(lotId, _cts.Token);
        }

        private async void buttonTestProgramEBSO_Click(object sender, EventArgs e)
        {
            if (_testPrograms.Count == 0)
            {
                UpdateStatus("No test program data. Investigate a lot first.", isError: true);
                MessageBox.Show(this, "No test program data. Please investigate a lot first.", "Info",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            try
            {
                SetBusyUI(true);
                StartProgress("Checking EBSO test programs…");
                var lotId = NormalizeLotId(textBoxLotId.Text);
                var list = await _engine.EngineCheckTestProgramEBSO(_testPrograms, _testProgramRevisions).ConfigureAwait(true);
                StopProgress($"EBSO test programs ready for {lotId}");
                var dlg = new TestProgramForm(list, $"Test Program for {lotId} lot in EBSO");
                dlg.Show(this);
            }
            catch (Exception ex)
            {
                UpdateStatus($"EBSO check failed: {ex.Message}", isError: true);
                _logSystem.Error("buttonTestProgramEBSO_Click failed: " + ex);
                MessageBox.Show(this, "Failed to load EBSO test programs.\n" + ex.Message, "Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                SetBusyUI(false);
            }
        }

