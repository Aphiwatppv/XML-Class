        public TransferRateResult MeasureTransferRate(string basePath, TimeSpan window, bool recursive = true, string? nameContains = null)
        {
            try
            {
                if (window <= TimeSpan.Zero) throw new ArgumentException("window must be > 0", nameof(window));
                var now = DateTime.Now;
                var start = now - window;

                _logSystem.Info($"MeasureTransferRate start: sudoUser={_sudoUser}, path={basePath}, window={window}, recursive={recursive}, filter={nameContains ?? "-"}");

                var rows = ExecFind(basePath, recursive, includeFiles: true, includeDirs: false);

                IEnumerable<FileEntry> filtered = rows.Where(f => f.MTime.HasValue && f.MTime.Value >= start && f.MTime.Value <= now);
                if (!string.IsNullOrWhiteSpace(nameContains))
                    filtered = filtered.Where(f => f.Name.Contains(nameContains, StringComparison.OrdinalIgnoreCase));

                int count = filtered.Count();
                var result = new TransferRateResult
                {
                    Files = count,
                    Window = window,
                    WindowStart = start,
                    WindowEnd = now,
                    PerMinute = count / window.TotalMinutes,
                    PerHour = count / window.TotalHours
                };

                _logSystem.Info($"MeasureTransferRate done: files={result.Files}, perMin={result.PerMinute:F2}, perHour={result.PerHour:F2}");
                return result;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"MeasureTransferRate error: {ex.Message}");
                throw;
            }
        }

        public TransferRateResult MeasureTransferRateLastMinutes(string basePath, int minutes, bool recursive = true, string? nameContains = null)
            => MeasureTransferRate(basePath, TimeSpan.FromMinutes(minutes), recursive, nameContains);

        public TransferRateResult MeasureTransferRateLastHours(string basePath, double hours, bool recursive = true, string? nameContains = null)
            => MeasureTransferRate(basePath, TimeSpan.FromHours(hours), recursive, nameContains);

        public QueueSizeResult GetQueueSize(string folderPath, bool recursive = false, string? nameContains = null)
        {
            try
            {
                _logSystem.Info($"GetQueueSize start: sudoUser={_sudoUser}, path={folderPath}, recursive={recursive}, filter={nameContains ?? "-"}");

                var rows = ExecFind(folderPath, recursive, includeFiles: true, includeDirs: false);

                IEnumerable<FileEntry> filtered = rows;
                if (!string.IsNullOrWhiteSpace(nameContains))
                    filtered = filtered.Where(f => f.Name.Contains(nameContains, StringComparison.OrdinalIgnoreCase));

                var list = filtered.ToList();
                var result = new QueueSizeResult { Pending = list.Count, Items = list };

                _logSystem.Info($"GetQueueSize done: pending={result.Pending}");
                if (result.Pending == 0) _logSystem.Warning("GetQueueSize: no pending files found.");
                return result;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"GetQueueSize error: {ex.Message}");
                throw;
            }
        }

        public QueueSizeResult GetQueueSizeNew(
string folderPath,
bool recursive = false,
string? nameContains = null,
bool includeFiles = true,
bool includeDirs = true
)
        {
            try
            {
                _logSystem.Info(
                $"GetQueueSize start: sudoUser={_sudoUser}, path={folderPath}, recursive={recursive}, " +
                $"filter={nameContains ?? "-"}, includeFiles={includeFiles}, includeDirs={includeDirs}");
                // Ask ExecFind for exactly what you want
                var rows = ExecFind(folderPath, recursive, includeFiles: includeFiles, includeDirs: includeDirs);

                IEnumerable<FileEntry> filtered = rows;

                if (!string.IsNullOrWhiteSpace(nameContains))
                    filtered = filtered.Where(f => f.Name.Contains(nameContains, StringComparison.OrdinalIgnoreCase));

                filtered = filtered.Where(f => f.Path != folderPath);
                var list = filtered.ToList();
                var result = new QueueSizeResult { Pending = list.Count, Items = list };

                _logSystem.Info($"GetQueueSize done: pending={result.Pending}");
                if (result.Pending == 0) _logSystem.Warning("GetQueueSize: no pending items found.");
                return result;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"GetQueueSize error: {ex.Message}");
                throw;
            }
        }

        // ==========================================================
        // 4) COPY: LOCAL → REMOTE  (SFTP to /tmp + sudo mv + chmod/chown)
        // ==========================================================
        public void CopyFileToRemote(string localPath, string remotePath, string? chmod = null, string? chown = null)
        {
            if (!File.Exists(localPath)) throw new FileNotFoundException("Local file not found", localPath);

            var tempName = $"upload_{Guid.NewGuid():N}";
            var tempRemote = $"/tmp/{tempName}";

            try
            {
                _logSystem.Info($"CopyFileToRemote start: sudoUser={_sudoUser}, local={localPath}, remote={remotePath}, chmod={chmod ?? "-"}, chown={chown ?? "-"}");

                // 1) Upload to temp via SFTP (login user)
                using (var sftp = CreateSftp(_auth))
                {
                    sftp.Connect();
                    using var lf = new FileStream(localPath, FileMode.Open, FileAccess.Read, FileShare.Read);
                    sftp.UploadFile(lf, tempRemote);
                    sftp.Disconnect();
                }

                // 2) sudo move to final + optional chmod/chown
                var destDir = $"$(dirname {Q(remotePath)})";
                string script = $"mkdir -p {destDir} && mv {Q(tempRemote)} {Q(remotePath)}";
                if (!string.IsNullOrWhiteSpace(chmod)) script += $" && chmod {chmod} {Q(remotePath)}";
                if (!string.IsNullOrWhiteSpace(chown)) script += $" && chown {chown} {Q(remotePath)}";

                var fullCmd = BuildSudoCmd(script);

                using var ssh = CreateSsh(_auth);
                ssh.Connect();
                var cmd = ssh.CreateCommand(fullCmd);
                var res = cmd.Execute();
                var exit = cmd.ExitStatus;
                ssh.Disconnect();

                if (exit != 0)
                {
                    _logSystem.Error($"CopyFileToRemote failed (exit {exit}). Error: {cmd.Error}");
                    throw new Exception($"sudo move failed (exit {exit}). Error: {cmd.Error}");
                }

                _logSystem.Info($"CopyFileToRemote done: {localPath} -> {remotePath}");
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CopyFileToRemote error ({localPath} -> {remotePath}): {ex.Message}");
                // Optional: try to clean tempRemote
                try
                {
                    using var ssh = CreateSsh(_auth);
                    ssh.Connect();
                    var cleanup = ssh.CreateCommand(BuildSudoCmd($"rm -f {Q(tempRemote)}"));
                    cleanup.Execute();
                    ssh.Disconnect();
                }
                catch { /* ignore cleanup failure */ }
                throw;
            }
        }

        // ==========================
        // 5) INTERNAL HELPERS
        // ==========================
        private List<FileEntry> ExecFind(string basePath, bool recursive, bool includeFiles, bool includeDirs)
        {
            var depthFlag = recursive ? "-mindepth 1" : "-maxdepth 1";
            var findCmd = $"find {Q(basePath)} {depthFlag} -printf '{{\"t\":\"%y\",\"s\":%s,\"m\":%T@,\"p\":\"%p\"}}\\n'";
            var fullCmd = BuildSudoCmd(findCmd);

            try
            {
                _logSystem.Info($"ExecFind start: sudoUser={_sudoUser}, path={basePath}, recursive={recursive}, files={includeFiles}, dirs={includeDirs}");
                string output = Run(_auth, fullCmd);

                var list = new List<FileEntry>();
                using var sr = new StringReader(output);
                string? line;
                while ((line = sr.ReadLine()) != null)
                {
                    line = line.Trim();

                    // Skip banners / any non-JSON text; only parse proper JSON lines
                    if (line.Length == 0 || line[0] != '{' || !line.EndsWith("}")) continue;

                    FindRec? rec = null;
                    try { rec = JsonSerializer.Deserialize<FindRec>(line); }
                    catch
                    {
                        _logSystem.Warning($"ExecFind: skipped unparsable line: {line}");
                        continue;
                    }
                    if (rec == null) continue;

                    bool isDir = rec.t == "d";
                    if ((isDir && includeDirs) || (!isDir && includeFiles))
                    {
                        DateTime? mtime = null;
                        try { mtime = DateTimeOffset.FromUnixTimeSeconds((long)rec.m).LocalDateTime; } catch { /* ignore */ }

                        var name = rec.p.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? "";
                        list.Add(new FileEntry { Name = name, Path = rec.p, IsDir = isDir, Size = rec.s, MTime = mtime });
                    }
                }

                list = list.OrderBy(r => r.Path).ThenBy(r => r.Name).ToList();
                _logSystem.Info($"ExecFind done: {list.Count} entries");
                if (list.Count == 0) _logSystem.Warning("ExecFind: no entries found.");
                return list;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"ExecFind error ({basePath}): {ex.Message}");
                throw;
            }
        }

        private static Dictionary<string, List<FileEntry>> GroupByDirectory(IEnumerable<FileEntry> rows)
            => rows.GroupBy(f => DirName(f.Path))
                   .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Name).ToList());

        private static string DirName(string path)
        {
            var p = path.Replace('\\', '/');
            var i = p.LastIndexOf('/');
            return i <= 0 ? "/" : p[..i];
        }

        private static SshClient CreateSsh(SSHAuth auth)
        {
            if (!string.IsNullOrWhiteSpace(auth.KeyFile))
            {
                var key = string.IsNullOrEmpty(auth.KeyPassphrase)
                    ? new PrivateKeyFile(auth.KeyFile)
                    : new PrivateKeyFile(auth.KeyFile, auth.KeyPassphrase);

                var conn = new ConnectionInfo(
                    auth.Hostname, auth.Port, auth.Username,
                    new AuthenticationMethod[] { new PrivateKeyAuthenticationMethod(auth.Username, key) }
                );
                return new SshClient(conn);
            }
            return new SshClient(auth.Hostname, auth.Port, auth.Username, auth.Password);
        }

        private static SftpClient CreateSftp(SSHAuth auth)
        {
            if (!string.IsNullOrWhiteSpace(auth.KeyFile))
            {
                var key = string.IsNullOrEmpty(auth.KeyPassphrase)
                    ? new PrivateKeyFile(auth.KeyFile)
                    : new PrivateKeyFile(auth.KeyFile, auth.KeyPassphrase);

                var conn = new ConnectionInfo(
                    auth.Hostname, auth.Port, auth.Username,
                    new AuthenticationMethod[] { new PrivateKeyAuthenticationMethod(auth.Username, key) }
                );
                return new SftpClient(conn);
            }
            return new SftpClient(auth.Hostname, auth.Port, auth.Username, auth.Password);
        }

        private static string Run(SSHAuth auth, string cmdText)
        {
            using var ssh = CreateSsh(auth);
            ssh.Connect();
            var cmd = ssh.CreateCommand(cmdText);
            var output = cmd.Execute();
            var exit = cmd.ExitStatus;
            var err = cmd.Error;
            ssh.Disconnect();

            if (exit != 0 && string.IsNullOrEmpty(output))
                throw new Exception($"Command failed (exit {exit}): {err}");

            return output;
        }

        // ==========================================
        // 6) CHECK CRONTAB (whether it exists or not)
        // ==========================================
        public CrontabResult CheckCrontabExists()
        {
            try
            {
                _logSystem.Info($"CheckCrontabExists start: sudoUser={_sudoUser}");

                // Instead of bash, call "sh" directly — it doesn't load .profile-ebs
                string script = "sh -c 'crontab -l 2>&1'";
                var cmdText = $"sudo -n -iu {_sudoUser} env -i TERM=dumb LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin {script}";

                using var ssh = CreateSsh(_auth);
                ssh.Connect();
                var cmd = ssh.CreateCommand(cmdText);
                var output = cmd.Execute();
                var exit = cmd.ExitStatus;
                ssh.Disconnect();

                // Split lines and trim
                var lines = output
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .ToList();

                // Filter banners (just in case)
                lines.RemoveAll(l =>
                    l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                    l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase)
                );

                var cleanOutput = string.Join("\n", lines);

                // Case 1: valid crontab
                if (exit == 0 && lines.Count > 0)
                {
                    var entries = lines
                        .Where(l => !string.IsNullOrWhiteSpace(l))
                        .ToList();

                    _logSystem.Info($"Crontab found for {_sudoUser}: {entries.Count} lines");
                    return new CrontabResult
                    {
                        Exists = true,
                        Entries = entries,
                        RawOutput = cleanOutput
                    };
                }

                // Case 2: "no crontab for" message
                if (cleanOutput.Contains("no crontab for", StringComparison.OrdinalIgnoreCase))
                {
                    _logSystem.Warning($"No crontab for {_sudoUser}");
                    return new CrontabResult { Exists = false, RawOutput = cleanOutput };
                }

                // Case 3: Unexpected failure
                if (exit != 0)
                {
                    _logSystem.Error($"CheckCrontabExists failed (exit {exit}): {cleanOutput}");
                    throw new Exception($"Unexpected error while checking crontab: {cleanOutput}");
                }

                // fallback
                _logSystem.Warning($"CheckCrontabExists ambiguous: output={cleanOutput}");
                return new CrontabResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckCrontabExists error: {ex.Message}");
                throw;
            }
        }

        public ProcessResult CheckProcessList(string? filter = null)
        {
            try
            {
                _logSystem.Info($"CheckProcessList start: sudoUser={_sudoUser}, filter={filter ?? "-"}");

                string script = "ps -ef 2>&1";
                var cmdText = BuildSudoCmd(script);

                using var ssh = CreateSsh(_auth);
                ssh.Connect();
                var cmd = ssh.CreateCommand(cmdText);
                var output = cmd.Execute();
                var exit = cmd.ExitStatus;
                ssh.Disconnect();

                // Split & clean lines
                var lines = output
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .ToList();

                // Filter banners just in case
                lines.RemoveAll(l =>
                    l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                    l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase)
                );

                if (!string.IsNullOrWhiteSpace(filter))
                    lines = lines.Where(l => l.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();

                var cleanOutput = string.Join("\n", lines);

                if (exit == 0 && lines.Count > 0)
                {
                    _logSystem.Info($"CheckProcessList done: {lines.Count} processes (filter={filter ?? "none"})");
                    return new ProcessResult
                    {
                        Exists = true,
                        Entries = lines,
                        RawOutput = cleanOutput
                    };
                }

                _logSystem.Warning($"No processes found (filter={filter ?? "none"})");
                return new ProcessResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckProcessList error: {ex.Message}");
                throw;
            }
        }
        public TopResult CheckTopProcesses(int topCount = 10)
        {
            try
            {
                _logSystem.Info($"CheckTopProcesses start: sudoUser={_sudoUser}, topCount={topCount}");

                // Run in batch mode (non-interactive)
                string script = "top -b -n 1 2>&1";
                var cmdText = BuildSudoCmd(script);

                using var ssh = CreateSsh(_auth);
                ssh.Connect();
                var cmd = ssh.CreateCommand(cmdText);
                var output = cmd.Execute();
                var exit = cmd.ExitStatus;
                ssh.Disconnect();

                var lines = output
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .ToList();

                // Remove banner noise
                lines.RemoveAll(l =>
                    l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                    l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase)
                );

                var cleanOutput = string.Join("\n", lines);

                // Find start of process section (line starting with PID)
                int startIdx = lines.FindIndex(l => l.StartsWith("PID "));
                var topLines = (startIdx >= 0)
                    ? lines.Skip(startIdx + 1).Take(topCount).ToList()
                    : lines.TakeLast(topCount).ToList();

                if (exit == 0 && topLines.Count > 0)
                {
                    _logSystem.Info($"CheckTopProcesses done: {topLines.Count} top entries.");
                    return new TopResult
                    {
                        Exists = true,
                        TopEntries = topLines,
                        RawOutput = cleanOutput
                    };
                }

                _logSystem.Warning($"No top processes found.");
                return new TopResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckTopProcesses error: {ex.Message}");
                throw;
            }
        }
        /// <summary>
        /// Check several processes at once by name/substring (case-insensitive).
        /// Returns per-name matches and overall AllFound/Missing.
        /// </summary>
        public MultiProcessResult CheckProcessesByNames(IEnumerable<string> processNames)
        {
            try
            {
                var names = processNames?.Where(n => !string.IsNullOrWhiteSpace(n)).ToList() ?? new List<string>();
                if (names.Count == 0) throw new ArgumentException("At least one process name must be provided.", nameof(processNames));

                _logSystem.Info($"CheckProcessesByNames start: sudoUser={_sudoUser}, count={names.Count}");

                var psLines = GetCleanProcessSnapshot(out var rawPs);
                var lowerPs = psLines
                    .Where(l => !l.Contains("grep -i", StringComparison.OrdinalIgnoreCase)) // ignore grep helpers
                    .Select(l => (orig: l, low: l.ToLowerInvariant()))
                    .ToList();

                var results = new Dictionary<string, ProcessResult>(StringComparer.OrdinalIgnoreCase);
                var missing = new List<string>();

                foreach (var name in names)
                {
                    var needle = name.ToLowerInvariant();
                    var matches = lowerPs
                        .Where(x => x.low.Contains(needle))
                        .Select(x => x.orig)
                        .ToList();

                    if (matches.Count > 0)
                    {
                        _logSystem.Info($"Process '{name}' found: {matches.Count} matches");
                        results[name] = new ProcessResult
                        {
                            Exists = true,
                            Entries = matches,
                            RawOutput = string.Join("\n", matches)
                        };
                    }
                    else
                    {
                        _logSystem.Warning($"Process '{name}' not found.");
                        results[name] = new ProcessResult { Exists = false, Entries = new List<string>(), RawOutput = "" };
                        missing.Add(name);
                    }
                }

                var allFound = missing.Count == 0;
                return new MultiProcessResult
                {
                    Results = results,
                    AllFound = allFound,
                    Missing = missing,
                    RawPsOutput = rawPs
                };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckProcessesByNames error: {ex.Message}");
                throw;
            }
        }
        private List<string> GetCleanProcessSnapshot(out string raw)
        {
            string script = "ps -ef 2>&1";
            var cmdText = BuildSudoCmd(script);

            using var ssh = CreateSsh(_auth);
            ssh.Connect();
            var cmd = ssh.CreateCommand(cmdText);
            var output = cmd.Execute();
            var exit = cmd.ExitStatus;
            ssh.Disconnect();

            raw = output;

            var lines = output
                .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(l => l.Trim())
                .ToList();

            // Remove banner / profile chatter if any
            lines.RemoveAll(l =>
                l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase));

            return lines;
        }

        public SpeedTestResult MeasureScpSpeedBetweenServers(
            string destHost,                 // destination server hostname/IP
            string destSshUser,              // ssh user on destination (often same as sudoUser)
            string destFolder = "/tmp",       // where to copy on destination
            int fileSizeMB = 200,            // test file size (MB)
            int ddBlockMB = 4                // dd block size (MB)
        )
        {
            try
            {
                _logSystem.Info(
                    $"MeasureScpSpeedBetweenServers start: sudoUser={_sudoUser}, dest={destSshUser}@{destHost}, sizeMB={fileSizeMB}");

                if (fileSizeMB <= 0) throw new ArgumentException("fileSizeMB must be > 0", nameof(fileSizeMB));
                if (ddBlockMB <= 0) ddBlockMB = 4;

                // Unique file names
                var id = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                var srcFile = $"/tmp/speedtest_{_sudoUser}_{id}.bin";
                var dstFile = $"{destFolder.TrimEnd('/')}/speedtest_{_sudoUser}_{id}.bin";

                // Bytes
                long bytes = (long)fileSizeMB * 1024L * 1024L;

                // Use /usr/bin/time -p for stable parsing: prints:
                // real <seconds>
                // user <seconds>
                // sys  <seconds>
                //
                // NOTE: scp options:
                // -oBatchMode=yes : no password prompts (fails fast)
                // -oStrictHostKeyChecking=no : avoid interactive host key prompt
                // -oConnectTimeout=10 : fail fast if unreachable
                // -q : quiet, reduce noise
                string scpOpts = "-q -oBatchMode=yes -oStrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null -oConnectTimeout=10";

                // Script executed on SOURCE server as sudo user
                // 1) create test file on source (dd)
                // 2) upload to dest with timed scp
                // 3) download back from dest with timed scp
                // 4) cleanup both sides
                string script = $@"
set -e
SRC={Q(srcFile)}
DST={Q(dstFile)}
DEST={Q(destSshUser + "@" + destHost)}
OPTS={Q(scpOpts)}

echo __SPEEDTEST_START__
echo SRC_FILE=$SRC
echo DST_FILE=$DST
echo BYTES={bytes}

# Create test file on source
dd if=/dev/zero of=$SRC bs={ddBlockMB}M count={(fileSizeMB + ddBlockMB - 1) / ddBlockMB} conv=fsync status=none

echo __UPLOAD_BEGIN__
/usr/bin/time -p scp $OPTS $SRC $DEST:$DST
echo __UPLOAD_END__

echo __DOWNLOAD_BEGIN__
/usr/bin/time -p scp $OPTS $DEST:$DST ${{SRC}}.dl
echo __DOWNLOAD_END__

# Cleanup
rm -f $SRC ${{SRC}}.dl
ssh -oBatchMode=yes -oStrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null -oConnectTimeout=10 $DEST ""rm -f $DST"" || true

echo __SPEEDTEST_END__
";

                // Run via sudo wrapper (your existing BuildSudoCmd + RunWithExit)
                string cmdText = BuildSudoCmd(script);
                var (output, exit, err) = RunWithExit(cmdText);

                var raw = (output ?? "") + (string.IsNullOrWhiteSpace(err) ? "" : ("\n" + err));

                // Parse "real <sec>" lines inside upload/download markers
                double uploadSec = ParseTimeSeconds(raw, "__UPLOAD_BEGIN__", "__UPLOAD_END__");
                double downloadSec = ParseTimeSeconds(raw, "__DOWNLOAD_BEGIN__", "__DOWNLOAD_END__");

                // Mbps = (bytes * 8) / seconds / 1e6
                double uploadMbps = uploadSec > 0 ? (bytes * 8.0) / uploadSec / 1_000_000.0 : 0;
                double downloadMbps = downloadSec > 0 ? (bytes * 8.0) / downloadSec / 1_000_000.0 : 0;

                _logSystem.Info($"SpeedTest done: upload={uploadMbps:F2} Mbps, download={downloadMbps:F2} Mbps");

                return new SpeedTestResult
                {
                    SourceHost = _auth.Hostname,
                    DestHost = destHost,
                    TestBytes = bytes,
                    UploadSeconds = uploadSec,
                    DownloadSeconds = downloadSec,
                    UploadMbps = uploadMbps,
                    DownloadMbps = downloadMbps,
                    RawOutput = raw
                };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"MeasureScpSpeedBetweenServers error: {ex.Message}");
                throw;
            }
        }

        // Helper: parse /usr/bin/time -p output between markers
        private static double ParseTimeSeconds(string text, string beginMarker, string endMarker)
        {
            bool inBlock = false;
            foreach (var line in text.Split('\n'))
            {
                var l = line.Trim();
                if (l == beginMarker) { inBlock = true; continue; }
                if (l == endMarker) { inBlock = false; continue; }

                // inside block: time -p prints "real <sec>"
                if (inBlock && l.StartsWith("real ", StringComparison.OrdinalIgnoreCase))
                {
                    var parts = l.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length >= 2 && double.TryParse(parts[1], out var sec))
                        return sec;
                }
            }
            return 0;
        }


    }
