    public sealed class DapperDataAccess 
    {
        private readonly IConnectService _connect;
 
        private readonly ILogSystem _log;

        public DapperDataAccess(IConnectService connect, ILogSystem log)
        {
            _connect = connect ?? throw new ArgumentNullException(nameof(connect));
            _log = log ?? throw new ArgumentNullException(nameof(log));
        }

        public async Task<IReadOnlyList<T>> QueryAsync<T>(string sql, object? param = null, int? commandTimeout = null, CommandType? commandType = null, CancellationToken ct = default)
        {

            using (IDbConnection dbConnection = new OracleConnection(_connect.BuildConnectionString()))
            {
                var result = await dbConnection.QueryAsync<T>(sql, param);
                _log.Info("Query OK ({Rows} rows)");
                return result;
            }            

  
        }

