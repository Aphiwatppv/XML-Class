SELECT 
        ID,CONFIG_OBJECTIVE,PRODUCT_TYPE,TEST_PROG_NAME,TEST_PROG_REVISION,MEASSTP_NAME,LOT_NUMBER,TESTER_NAME,STDF_FILE_NAME,CONFIG_STATUS,CONFIG_ID,REQUEST_DATE,REPLY_DATE
FROM 
        DLSM_STDF
WHERE 
        lot_number = :lot_id
ORDER BY 
        REQUEST_DATE DESC

SELECT
    CONFIG_OBJECTIVE,
    PRODUCT_TYPE,
    TEST_PROG_NAME,
    TEST_PROG_REVISION,
    MEASSTP_NAME,
    LOT_NUMBER,
    TESTER_NAME,
    MAX(REQUEST_DATE) AS LAST_REQUEST_DATE,
    MAX(REPLY_DATE)   AS LAST_REPLY_DATE,
    MAX(STDF_FILE_NAME) KEEP (DENSE_RANK LAST ORDER BY REQUEST_DATE) AS LAST_STDF_FILE_NAME,
    COUNT(*) AS TOTAL_RECORDS
FROM
    DLSM_STDF
WHERE
    LOT_NUMBER = :lot_id
GROUP BY
    CONFIG_OBJECTIVE,
    PRODUCT_TYPE,
    TEST_PROG_NAME,
    TEST_PROG_REVISION,
    MEASSTP_NAME,
    LOT_NUMBER,
    TESTER_NAME
ORDER BY
    LAST_REQUEST_DATE DESC;

