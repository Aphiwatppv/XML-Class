namespace BKGEBSInvestigation.WTForm
{
    public partial class XeForm : Form
    {
        private readonly IReadOnlyCollection<XeExtractionSummary> _rows;

        public XeForm(IReadOnlyCollection<XeExtractionSummary> xeExtractionRecord, string name)
        {
            InitializeComponent();
            this.Text = name;
            _rows = xeExtractionRecord ?? Array.Empty<XeExtractionSummary>();
            InitialSetupUI();
        }

        private void InitialSetupUI()
        {
            InitializeSyle.InitializeDataGridView(dataGridView1);
            dataGridView1.AutoGenerateColumns = false;
            dataGridView1.DataSource = _rows.ToList();

            if (dataGridView1.Columns.Count == 0)
            {
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn { DataPropertyName = nameof(XeExtractionSummary.XE_ID), HeaderText = "XE_ID", Width = 100 });
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn { DataPropertyName = nameof(XeExtractionSummary.XE_NAME), HeaderText = "XE_NAME", Width = 240 });
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn { DataPropertyName = nameof(XeExtractionSummary.XE_PID), HeaderText = "XE_PID", Width = 100 });
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn { DataPropertyName = nameof(XeExtractionSummary.XE_PROGRESS), HeaderText = "PROGRESS", Width = 90 });
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn { DataPropertyName = nameof(XeExtractionSummary.XE_STATUS_DESC), HeaderText = "STATUS", Width = 200 });
                dataGridView1.Columns.Add(new DataGridViewTextBoxColumn
                {
                    DataPropertyName = nameof(XeExtractionSummary.XE_CREATE),
                    HeaderText = "CREATE",
                    Width = 160,
                    DefaultCellStyle = { Format = "yyyy-MM-dd HH:mm:ss" }
                });
            }

            dataGridView1.CellDoubleClick += DataGridView1_CellDoubleClick;
        }

        private async void DataGridView1_CellDoubleClick(object? sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            var item = dataGridView1.Rows[e.RowIndex].DataBoundItem as XeExtractionSummary;
            if (item == null) return;

            if (EngineProvider.Current == null)
            {
                MessageBox.Show(this, "Engine is not configured.", "Configuration",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            UseWaitCursor = true;
            try
            {
                var detail = await EngineProvider.Current
                    .GetExtractionDetailByIdAsync(item.XE_ID, CancellationToken.None)
                    .ConfigureAwait(true);

                if (detail == null)
                {
                    MessageBox.Show(this, $"No details found for XE_ID={item.XE_ID}.",
                        "Not found", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                using (var dlg = new XeDetailForm(detail))
                {
                    dlg.StartPosition = FormStartPosition.CenterParent;
                    dlg.ShowDialog(this);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(this, "Failed to load detail.\n" + ex.Message, "Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                UseWaitCursor = false;
            }
        }
    }
}


public sealed class XeDetailForm : Form
{
    private readonly XeExtractionRecord _rec;

    public XeDetailForm(XeExtractionRecord rec)
    {
        _rec = rec ?? throw new ArgumentNullException(nameof(rec));
        Text = $"XE Detail — {_rec.XE_NAME} ({_rec.XE_ID})";
        Width = 1000;
        Height = 700;
        BackColor = Color.White;
        FormBorderStyle = FormBorderStyle.Sizable;

        var meta = new PropertyGrid
        {
            Dock = DockStyle.Left,
            Width = 360,
            HelpVisible = false,
            ToolbarVisible = false,
            PropertySort = PropertySort.NoSort,
            SelectedObject = new MetaView(_rec)
        };

        var edlBox = new RichTextBox
        {
            Dock = DockStyle.Fill,
            ReadOnly = true,
            WordWrap = false,
            BorderStyle = BorderStyle.None,
            BackColor = Color.Black,
            ForeColor = Color.Lime,
            Font = new Font("Consolas", 10.5f, FontStyle.Regular),
            DetectUrls = false,
            HideSelection = false,
            ScrollBars = RichTextBoxScrollBars.Both,
            Text = string.IsNullOrEmpty(_rec.XE_EDL) ? "<empty>" : _rec.XE_EDL
        };

        var copyBtn = new Button
        {
            Text = "Copy XE_EDL",
            Dock = DockStyle.Top,
            Height = 34,
            FlatStyle = FlatStyle.Flat
        };
        copyBtn.FlatAppearance.BorderSize = 0;
        copyBtn.Click += (_, __) =>
        {
            try { Clipboard.SetText(edlBox.Text ?? ""); }
            catch (Exception ex)
            {
                MessageBox.Show(this, ex.Message, "Copy Failed",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        };

        var rightPanel = new Panel { Dock = DockStyle.Fill, Padding = new Padding(8) };
        rightPanel.Controls.Add(edlBox);
        rightPanel.Controls.Add(copyBtn);

        var split = new SplitContainer
        {
            Dock = DockStyle.Fill,
            FixedPanel = FixedPanel.Panel1,
            SplitterDistance = meta.Width
        };
        split.Panel1.Controls.Add(meta);
        split.Panel2.Controls.Add(rightPanel);

        Controls.Add(split);
    }

    private sealed class MetaView
    {
        public MetaView(XeExtractionRecord r)
        {
            XE_ID = r.XE_ID;
            XE_NAME = r.XE_NAME;
            XE_PID = r.XE_PID;
            XE_CREATE = r.XE_CREATE;
            XE_START = r.XE_START;
            XE_END = r.XE_END;
            XE_STATUS = r.XE_STATUS;
            XE_PROGRESS = r.XE_PROGRESS;
            XE_STATUS_DESC = r.XE_STATUS_DESC;
            XE_OWNER = r.XE_OWNER;
            XE_TYPE = r.XE_TYPE;
            XE_DELIVTYPE = r.XE_DELIVTYPE;
            CLNT_COMMUNICATION_ID = r.CLNT_COMMUNICATION_ID;
        }

        public long XE_ID { get; }
        public string XE_NAME { get; }
        public long? XE_PID { get; }
        public DateTime? XE_CREATE { get; }
        public DateTime? XE_START { get; }
        public DateTime? XE_END { get; }
        public string XE_STATUS { get; }
        public int? XE_PROGRESS { get; }
        public string XE_STATUS_DESC { get; }
        public string XE_OWNER { get; }
        public string XE_TYPE { get; }
        public string XE_DELIVTYPE { get; }
        public string CLNT_COMMUNICATION_ID { get; }
    }
}
