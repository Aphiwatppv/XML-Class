 private async void btnEBSoXe1_Click(object sender, EventArgs e) // from my main form
 {
     try
     {
         SetBusyUI(true);
         StartProgress("Checking Xe1…");
         var lotId = NormalizeLotId(textBoxLotId.Text);
         var xe1 = await _engine.EngineGetXe1XeExtractionSummary(lotId).ConfigureAwait(true);
         StopProgress($"Xe1 for {lotId}");
         var dlg = new XeForm(xe1, $"Xe1 for {lotId} lot in EBSO");
         dlg.Show(this);
     }
     catch (Exception ex)
     {
         UpdateStatus($"Xe1 EBSO check failed: {ex.Message}", isError: true);
         _logSystem.Error("btnEBSoXe1_Click failed: " + ex);
         MessageBox.Show(this, "Failed to load Xe1 records.\n" + ex.Message, "Error",
             MessageBoxButtons.OK, MessageBoxIcon.Error);
     }
     finally
     {
         SetBusyUI(false);
     }
 }

