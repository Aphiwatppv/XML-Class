public async Task<IReadOnlyList<XeExtractionRecord>> GetExtractionsByIdNamePidAsync(
    long? xeId = null,
    string? xeName = null,
    long? xePid = null,
    CancellationToken ct = default)
{
    const string sql = @"
SELECT
    XE_ID,
    XE_NAME,
    XE_PID,
    XE_CREATE,
    XE_START,
    XE_END,
    XE_STATUS,
    XE_PROGRESS,
    XE_STATUS_DESC,
    XE_OWNER,
    XE_TYPE,
    XE_DELIVTYPE,
    XE_EDL,
    CLNT_COMMUNICATION_ID
FROM XE_EXTRACTIONS
WHERE 
    (:xe_id IS NULL OR XE_ID = :xe_id)
    AND (:xe_name IS NULL OR XE_NAME LIKE '%' || :xe_name || '%')
    AND (:xe_pid IS NULL OR XE_PID = :xe_pid)
ORDER BY XE_CREATE DESC";

    var param = new
    {
        xe_id = xeId,
        xe_name = xeName,
        xe_pid = xePid
    };

    _log.Info($"[XE_EXTRACTIONS] Search by XE_ID={xeId}, XE_NAME={xeName}, XE_PID={xePid}");

    return await _db.QueryAsync<XeExtractionRecord>(
        sql, param, commandType: CommandType.Text, ct: ct);
}


public async Task<IReadOnlyList<XeExtractionSummary>> GetTopExtractionsByLotPatternAsync(
    string lotPattern,
    int topN = 10,
    CancellationToken ct = default)
{
    if (string.IsNullOrWhiteSpace(lotPattern))
        throw new ArgumentException("lotPattern is required.", nameof(lotPattern));

    const string sql = @"
SELECT
    XE_ID,
    XE_NAME,
    XE_PID
FROM (
    SELECT
        XE_ID,
        XE_NAME,
        XE_PID,
        XE_CREATE
    FROM XE_EXTRACTIONS
    WHERE DBMS_LOB.INSTR(XE_EDL, :lot_pattern) > 0
    ORDER BY XE_CREATE DESC
)
WHERE ROWNUM <= :top_n
ORDER BY XE_CREATE DESC";

    var param = new
    {
        lot_pattern = lotPattern,
        top_n = topN
    };

    _log.Info($"[XE_EXTRACTIONS] Searching top {topN} records in XE_EDL for pattern: {lotPattern}");

    return await _db.QueryAsync<XeExtractionSummary>(
        sql, param, commandType: CommandType.Text, ct: ct);
}


