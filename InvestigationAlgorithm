using InvestigationServices.ModelEBSO;
using System.Text.RegularExpressions;

namespace BKGEBSInvestigation.InvestigationServicesUserController
{
    // -------------------- OUTPUT MODELS --------------------

    public enum FindingSeverity { Info, Warning, Critical }

    public sealed record Finding(
        FindingSeverity Severity,
        string Title,
        string Detail);

    public sealed record InvestigationReport(
        string Lot,
        string Operation,
        string BasicType,
        string TotalWafers,
        IReadOnlyList<Finding> Findings)
    {
        public string ToReadableText()
            => string.Join(
                Environment.NewLine + Environment.NewLine,
                Findings.Select(f => $"[{f.Severity}] {f.Title}{Environment.NewLine}{f.Detail}"));
    }

    // -------------------- MAIN ALGORITHM --------------------

    public sealed class AlgorithmInvestigate
    {
        private readonly List<StdfGroupedResult> _stepp;
        private readonly List<MeasurementGroupByStep> _ebso;
        private readonly List<MeasurementGroupByStep> _ebsa;

        private readonly string _currentOper;
        private readonly string _basicType;
        private readonly string _totalWafers;
        private readonly string _lot;

        /// <summary>
        /// Investigation algorithm that compares STEPP vs EBSO vs EBSA using:
        /// - Step presence (S1/S2/S3)
        /// - Wafer count per step
        /// - Additional STEPP details: TEST_PROG_REVISON, LAST_REPLY_DATE
        /// </summary>
        public AlgorithmInvestigate(
            List<StdfGroupedResult> stepp,
            List<MeasurementGroupByStep> ebso,
            List<MeasurementGroupByStep> ebsa,
            string currentOper,
            string basicType,
            string totalWafers,
            string lot)
        {
            _stepp = stepp ?? new List<StdfGroupedResult>();
            _ebso = ebso ?? new List<MeasurementGroupByStep>();
            _ebsa = ebsa ?? new List<MeasurementGroupByStep>();

            _currentOper = currentOper ?? string.Empty;
            _basicType = basicType ?? string.Empty;
            _totalWafers = totalWafers ?? string.Empty;
            _lot = lot ?? string.Empty;
        }

        /// <summary>
        /// Run full investigation and return a structured report.
        /// </summary>
        public InvestigationReport Run()
        {
            var findings = new List<Finding>();

            // 1) Basic info
            findings.Add(BuildBasicInfoFinding());

            // 2) Expected steps by operation (concept rule)
            var expectedSteps = GetExpectedSteps(_currentOper);
            if (expectedSteps.Count > 0)
            {
                findings.Add(new Finding(
                    FindingSeverity.Info,
                    "Expected test modes by operation",
                    $"{_currentOper} expects: {string.Join(", ", expectedSteps)}"));
            }
            else
            {
                findings.Add(new Finding(
                    FindingSeverity.Info,
                    "Operation rule",
                    $"Operation '{_currentOper}' is not mapped to expected steps (S1/S2/S3). The algorithm will compare based on available data only."));
            }

            // 3) Summaries
            findings.AddRange(InvestigateStepp(expectedSteps));
            findings.AddRange(InvestigateEbs("EBSO", _ebso, expectedSteps));
            findings.AddRange(InvestigateEbs("EBSA", _ebsa, expectedSteps));

            // 4) Your custom rules (pickup/missing step + wafer mismatch)
            findings.AddRange(ApplyPickupAndMismatchRules());

            // 5) Extra correlation signals (optional, but helpful)
            findings.AddRange(ExtraCorrelationSignals());

            return new InvestigationReport(_lot, _currentOper, _basicType, _totalWafers, findings);
        }

        // -------------------- BASIC INFO --------------------

        private Finding BuildBasicInfoFinding()
        {
            if (string.IsNullOrWhiteSpace(_basicType) &&
                string.IsNullOrWhiteSpace(_currentOper) &&
                string.IsNullOrWhiteSpace(_totalWafers))
            {
                return new Finding(
                    FindingSeverity.Warning,
                    "Basic information is missing",
                    $"Basic info is empty. Please check lot '{_lot}' whether it is registered in MES UI.");
            }

            return new Finding(
                FindingSeverity.Info,
                "Basic information",
                $"Lot '{_lot}' is registered in MES UI. BasicType='{_basicType}', TotalWafers='{_totalWafers}', CurrentOper='{_currentOper}'.");
        }

        private static List<string> GetExpectedSteps(string oper)
        {
            return oper switch
            {
                "4100" => new List<string> { "S1" },
                "4200" => new List<string> { "S1", "S2" },
                "4300" => new List<string> { "S1", "S2", "S3" },
                _ => new List<string>()
            };
        }

        // -------------------- SUMMARIES --------------------

        private IEnumerable<Finding> InvestigateStepp(IReadOnlyList<string> expectedSteps)
        {
            if (!_stepp.Any())
            {
                yield return new Finding(
                    FindingSeverity.Warning,
                    "STEPP data not found",
                    $"No STEPP record found for lot '{_lot}'. This may indicate upstream data missing or query issue.");
                yield break;
            }

            var stepNames = _stepp
                .Select(x => x.MEASSTP_NAME ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Select(NormalizeStep)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(ParseStepNumber)
                .ToList();

            var testers = _stepp
                .Select(x => x.TESTER_NAME ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .ToList();

            var testPrograms = _stepp
                .Select(x => x.TEST_PROG_NAME ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .ToList();

            // Additional requested detail
            var revisions = _stepp
                .Select(x => x.TEST_PROG_REVISION ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .ToList();

            var lastReply = MaxDate(_stepp.Select(x => x.LAST_REPLY_DATE));

            // wafers by step
            var wafersByStep = _stepp
                .Where(x => !string.IsNullOrWhiteSpace(x.MEASSTP_NAME))
                .GroupBy(x => NormalizeStep(x.MEASSTP_NAME!))
                .Select(g => new
                {
                    Step = g.Key,
                    Total = g.Sum(x => SafeInt(x.TOTAL_WAFER.ToString()))
                })
                .OrderBy(x => ParseStepNumber(x.Step))
                .ToList();

            yield return new Finding(
                FindingSeverity.Info,
                "STEPP summary",
                $"TestModes: {string.Join(", ", stepNames)}{Environment.NewLine}" +
                $"Wafers by step: {string.Join(", ", wafersByStep.Select(x => $"{x.Step}={x.Total}"))}{Environment.NewLine}" +
                $"Testers: {testers.Count} ({PreviewList(testers, 3)}){Environment.NewLine}" +
                $"TestPrograms: {PreviewList(testPrograms, 2)}{Environment.NewLine}" +
                $"TestProgramRevision: {PreviewList(revisions, 3)}{Environment.NewLine}" +
                $"LastReplyDate: {FormatDate(lastReply)}"
            );

            if (expectedSteps.Count > 0)
            {
                var missing = expectedSteps.Except(stepNames, StringComparer.OrdinalIgnoreCase).ToList();
                if (missing.Any())
                {
                    yield return new Finding(
                        FindingSeverity.Warning,
                        "STEPP missing expected test mode(s)",
                        $"Expected: {string.Join(", ", expectedSteps)} but STEPP has: {string.Join(", ", stepNames)}. Missing: {string.Join(", ", missing)}");
                }
            }
        }

        private IEnumerable<Finding> InvestigateEbs(string systemName, List<MeasurementGroupByStep> data, IReadOnlyList<string> expectedSteps)
        {
            if (!data.Any())
            {
                yield return new Finding(
                    FindingSeverity.Warning,
                    $"{systemName} data not found",
                    $"No {systemName} record found for lot '{_lot}'. If STEPP exists, this could indicate pipeline transfer/aggregation issue.");
                yield break;
            }

            var steps = data
                .Select(x => x.STEP ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Select(NormalizeStep)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(ParseStepNumber)
                .ToList();

            var totalWafersByStep = data
                .Where(x => !string.IsNullOrWhiteSpace(x.STEP))
                .GroupBy(x => NormalizeStep(x.STEP!))
                .Select(g => new { Step = g.Key, Total = g.Sum(x => SafeInt(x.WAFER_COUNT.ToString())) })
                .OrderBy(x => ParseStepNumber(x.Step))
                .ToList();

            yield return new Finding(
                FindingSeverity.Info,
                $"{systemName} summary",
                $"Steps: {string.Join(", ", steps)}{Environment.NewLine}" +
                $"Wafers by step: {string.Join(", ", totalWafersByStep.Select(x => $"{x.Step}={x.Total}"))}");

            if (expectedSteps.Count > 0)
            {
                var missing = expectedSteps.Except(steps, StringComparer.OrdinalIgnoreCase).ToList();
                if (missing.Any())
                {
                    yield return new Finding(
                        FindingSeverity.Warning,
                        $"{systemName} missing expected test mode(s)",
                        $"Expected: {string.Join(", ", expectedSteps)} but {systemName} has: {string.Join(", ", steps)}. Missing: {string.Join(", ", missing)}");
                }
            }
        }

        // -------------------- YOUR RULES (PRESENCE + MISMATCH) --------------------

        private IEnumerable<Finding> ApplyPickupAndMismatchRules()
        {
            // Build step sets
            var steppSteps = GetStepsFromStepp(_stepp);
            var ebsoSteps = GetStepsFromEbs(_ebso);
            var ebsaSteps = GetStepsFromEbs(_ebsa);

            // Build wafer maps
            var steppWafers = GetWafersByStepFromStepp(_stepp);
            var ebsoWafers = GetWafersByStepFromEbs(_ebso);
            var ebsaWafers = GetWafersByStepFromEbs(_ebsa);

            // STEPP -> EBSO rules
            foreach (var step in new[] { "S1", "S2", "S3" })
            {
                // Presence mismatch
                if (steppSteps.Contains(step) && !ebsoSteps.Contains(step))
                {
                    yield return new Finding(
                        FindingSeverity.Critical,
                        $"STEPP has {step} but EBSO missing {step}",
                        $"STEPP contains {step}, but EBSO does not.{Environment.NewLine}" +
                        $"Conclusion: data can't process in loader Module OR EMA Script can't pick up file.{Environment.NewLine}" +
                        $"STEPP steps: {FormatSteps(steppSteps)} | EBSO steps: {FormatSteps(ebsoSteps)}");
                }

                // Wafer mismatch
                if (steppSteps.Contains(step) && ebsoSteps.Contains(step))
                {
                    var st = steppWafers.TryGetValue(step, out var a) ? a : 0;
                    var eo = ebsoWafers.TryGetValue(step, out var b) ? b : 0;

                    if (st != eo)
                    {
                        yield return new Finding(
                            FindingSeverity.Critical,
                            $"Wafer mismatch at {step} (STEPP vs EBSO)",
                            $"STEPP {step} wafers={st}, EBSO {step} wafers={eo}.{Environment.NewLine}" +
                            $"Conclusion: data can't process in loader Module of EBSO OR EMA Script can't pick up remaining wafer files from STEPP.");
                    }
                }
                // if number of wafer in stepp mitmatch with MES UI . the reason can happend from this lot still testing in the test flor
            }

            // EBSO -> EBSA rules
            foreach (var step in new[] { "S1", "S2", "S3" })
            {
                // Presence mismatch
                if (ebsoSteps.Contains(step) && !ebsaSteps.Contains(step))
                {
                    yield return new Finding(
                        FindingSeverity.Critical,
                        $"EBSO has {step} but EBSA missing {step}",
                        $"EBSO contains {step}, but EBSA does not.{Environment.NewLine}" +
                        $"Conclusion: data can't process in loader Module of EBSA OR EMA Script can't pick up file from EBSO.{Environment.NewLine}" +
                        $"EBSO steps: {FormatSteps(ebsoSteps)} | EBSA steps: {FormatSteps(ebsaSteps)}");
                }

                // Wafer mismatch
                if (ebsoSteps.Contains(step) && ebsaSteps.Contains(step))
                {
                    var eo = ebsoWafers.TryGetValue(step, out var a) ? a : 0;
                    var ea = ebsaWafers.TryGetValue(step, out var b) ? b : 0;

                    if (eo != ea)
                    {
                        yield return new Finding(
                            FindingSeverity.Critical,
                            $"Wafer mismatch at {step} (EBSO vs EBSA)",
                            $"EBSO {step} wafers={eo}, EBSA {step} wafers={ea}.{Environment.NewLine}" +
                            $"Conclusion: data can't process in loader Module of EBSA OR EMA Script can't pick up remaining wafer files from EBSO.");
                    }
                }
            }
        }

        // -------------------- EXTRA SIGNALS (OPTIONAL) --------------------

        private IEnumerable<Finding> ExtraCorrelationSignals()
        {
            // Strong signal: STEPP has recent update but EBSO is empty
            var lastReply = MaxDate(_stepp.Select(x => x.LAST_REPLY_DATE));
            if (lastReply != null && _stepp.Any() && !_ebso.Any())
            {
                yield return new Finding(
                    FindingSeverity.Critical,
                    "Strong signal: STEPP updated but EBSO empty",
                    $"STEPP last reply at {FormatDate(lastReply)} but EBSO has no data.{Environment.NewLine}" +
                    "Highly suspect loader/EMA pickup issue between STEPP and EBSO.");
            }

            // Strong signal: EBSO exists but EBSA empty
            if (_ebso.Any() && !_ebsa.Any())
            {
                yield return new Finding(
                    FindingSeverity.Warning,
                    "Signal: EBSO has data but EBSA empty",
                    "EBSO contains data but EBSA has no data. Suspect forwarding/replication/pickup issue from EBSO to EBSA.");
            }
        }

        // -------------------- DATA VIEW HELPERS --------------------

        private static HashSet<string> GetStepsFromStepp(List<StdfGroupedResult> stepp)
            => stepp.Select(x => x.MEASSTP_NAME ?? "")
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .Select(NormalizeStep)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

        private static HashSet<string> GetStepsFromEbs(List<MeasurementGroupByStep> ebs)
            => ebs.Select(x => x.STEP ?? "")
                  .Where(s => !string.IsNullOrWhiteSpace(s))
                  .Select(NormalizeStep)
                  .ToHashSet(StringComparer.OrdinalIgnoreCase);

        private static Dictionary<string, int> GetWafersByStepFromStepp(List<StdfGroupedResult> stepp)
            => stepp.Where(x => !string.IsNullOrWhiteSpace(x.MEASSTP_NAME))
                    .GroupBy(x => NormalizeStep(x.MEASSTP_NAME!))
                    .ToDictionary(
                        g => g.Key,
                        g => g.Sum(x => SafeInt(x.TOTAL_WAFER.ToString())),
                        StringComparer.OrdinalIgnoreCase);

        private static Dictionary<string, int> GetWafersByStepFromEbs(List<MeasurementGroupByStep> ebs)
            => ebs.Where(x => !string.IsNullOrWhiteSpace(x.STEP))
                  .GroupBy(x => NormalizeStep(x.STEP!))
                  .ToDictionary(
                      g => g.Key,
                      g => g.Sum(x => SafeInt(x.WAFER_COUNT.ToString())),
                      StringComparer.OrdinalIgnoreCase);

        // -------------------- GENERAL HELPERS --------------------

        private static string NormalizeStep(string step)
            => step.Trim().ToUpperInvariant(); // "s1" -> "S1"

        private static int ParseStepNumber(string step)
        {
            // S1 -> 1, S2 -> 2, S10 -> 10, unknown -> 9999
            if (string.IsNullOrWhiteSpace(step)) return 9999;

            var m = Regex.Match(step.Trim(), @"(\d+)");
            return m.Success && int.TryParse(m.Groups[1].Value, out var n) ? n : 9999;
        }

        private static string FormatSteps(HashSet<string> steps)
            => steps.Count == 0 ? "-" : string.Join(", ", steps.OrderBy(ParseStepNumber));

        private static int SafeInt(string? v)
        {
            if (string.IsNullOrWhiteSpace(v)) return 0;

            if (int.TryParse(v.Trim(), out var n)) return n;

            if (double.TryParse(v.Trim(), out var d))
                return (int)Math.Round(d);

            return 0;
        }

        private static DateTime? MaxDate(IEnumerable<DateTime?> dates)
        {
            DateTime? max = null;
            foreach (var d in dates)
            {
                if (d == null) continue;
                if (max == null || d.Value > max.Value) max = d.Value;
            }
            return max;
        }

        private static string FormatDate(DateTime? dt)
            => dt == null ? "-" : dt.Value.ToString("yyyy-MM-dd HH:mm:ss");

        private static string PreviewList(List<string> items, int max)
        {
            if (items.Count == 0) return "-";
            return items.Count <= max
                ? string.Join(", ", items)
                : string.Join(", ", items.Take(max)) + ", ...";
        }
    }
}

