using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Windows.Forms;

namespace BKGEBSInvestigation.InvestigationServicesUserController
{
    /// <summary>
    /// WinForms-friendly presenter that:
    /// 1) Injects InvestigationReport
    /// 2) Builds readable text (Story + Findings)
    /// 3) Displays into TextBox or RichTextBox
    ///
    /// Theme: Dark tone (47,47,47) to match your app.
    /// </summary>
    public sealed class InvestigationReportPresenter
    {
        private InvestigationReport? _report;

        // -------------------- THEME (47,47,47) --------------------
        // Base UI tone
        private static readonly Color UiBackground = Color.FromArgb(47, 47, 47);          // #2F2F2F
        private static readonly Color UiHeaderText = Color.FromArgb(230, 230, 230);       // #E6E6E6
        private static readonly Color UiBodyText = Color.FromArgb(208, 208, 208);         // #D0D0D0

        // Muted severity colors (dark UI friendly)
        private static readonly Color UiInfo = Color.FromArgb(154, 160, 166);             // #9AA0A6
        private static readonly Color UiWarning = Color.FromArgb(201, 162, 77);           // #C9A24D
        private static readonly Color UiCritical = Color.FromArgb(198, 93, 93);           // #C65D5D

        // Optional subtle separators
        private static readonly Color UiSeparator = Color.FromArgb(70, 70, 70);           // slightly lighter than background

        /// <summary>
        /// Inject (set) report result into presenter
        /// </summary>
        public InvestigationReportPresenter Inject(InvestigationReport report)
        {
            _report = report ?? throw new ArgumentNullException(nameof(report));
            return this;
        }

        /// <summary>
        /// Build a combined string for UI (plain text)
        /// </summary>
        public string BuildText(
            bool includeStory = true,
            bool includeReadableFindings = true,
            bool includeSummaryHeader = true,
            int maxFindingsPerSeverity = 999)
        {
            if (_report == null) return "No report data (please run investigation first).";

            var sb = new StringBuilder();

            if (includeSummaryHeader)
            {
                sb.AppendLine("=== Investigation Report ===");
                sb.AppendLine($"Lot: {_report.Lot}");
                sb.AppendLine($"Operation: {_report.Operation}");
                sb.AppendLine($"BasicType: {_report.BasicType}");
                sb.AppendLine($"MES TotalWafers: {_report.TotalWafers}");
                sb.AppendLine();

                var crit = _report.Findings.Count(f => f.Severity == FindingSeverity.Critical);
                var warn = _report.Findings.Count(f => f.Severity == FindingSeverity.Warning);
                var info = _report.Findings.Count(f => f.Severity == FindingSeverity.Info);
                sb.AppendLine($"Findings: Critical={crit}, Warning={warn}, Info={info}");
                sb.AppendLine();
            }

            if (includeStory)
            {
                sb.AppendLine("=== Story ===");
                sb.AppendLine(_report.ToStory().TrimEnd());
                sb.AppendLine();
            }

            if (includeReadableFindings)
            {
                sb.AppendLine("=== Findings (Detailed) ===");
                sb.AppendLine(RenderFindingsBySeverity(_report.Findings, maxFindingsPerSeverity));
            }

            return sb.ToString().TrimEnd();
        }

        /// <summary>
        /// Show in TextBox (plain text).
        /// Note: TextBox cannot color individual lines.
        /// </summary>
        public void Show(TextBox textBox,
            bool includeStory = true,
            bool includeReadableFindings = true,
            bool includeSummaryHeader = true,
            int maxFindingsPerSeverity = 999)
        {
            if (textBox == null) throw new ArgumentNullException(nameof(textBox));

            ApplyTextBoxTheme(textBox);

            textBox.Text = BuildText(
                includeStory: includeStory,
                includeReadableFindings: includeReadableFindings,
                includeSummaryHeader: includeSummaryHeader,
                maxFindingsPerSeverity: maxFindingsPerSeverity);
        }

        /// <summary>
        /// Show in RichTextBox (plain text mode, no per-line color)
        /// </summary>
        public void Show(RichTextBox richTextBox,
            bool includeStory = true,
            bool includeReadableFindings = true,
            bool includeSummaryHeader = true,
            int maxFindingsPerSeverity = 999)
        {
            if (richTextBox == null) throw new ArgumentNullException(nameof(richTextBox));

            ApplyRichTextBoxTheme(richTextBox);

            richTextBox.Clear();
            richTextBox.Text = BuildText(
                includeStory: includeStory,
                includeReadableFindings: includeReadableFindings,
                includeSummaryHeader: includeSummaryHeader,
                maxFindingsPerSeverity: maxFindingsPerSeverity);
        }

        /// <summary>
        /// Show in RichTextBox with dark-theme friendly coloring:
        /// - Critical: muted red (#C65D5D)
        /// - Warning : muted amber (#C9A24D)
        /// - Info    : cool gray (#9AA0A6)
        /// </summary>
        public void ShowColored(RichTextBox richTextBox,
            bool includeStory = true,
            bool includeSummaryHeader = true,
            int maxFindingsPerSeverity = 999)
        {
            if (richTextBox == null) throw new ArgumentNullException(nameof(richTextBox));

            ApplyRichTextBoxTheme(richTextBox);

            if (_report == null)
            {
                richTextBox.Text = "No report data (please run investigation first).";
                return;
            }

            richTextBox.Clear();
            richTextBox.HideSelection = false;

            // Header
            if (includeSummaryHeader)
            {
                AppendLine(richTextBox, "=== Investigation Report ===", UiHeaderText, bold: true);
                AppendLine(richTextBox, $"Lot: {_report.Lot}", UiBodyText);
                AppendLine(richTextBox, $"Operation: {_report.Operation}", UiBodyText);
                AppendLine(richTextBox, $"BasicType: {_report.BasicType}", UiBodyText);
                AppendLine(richTextBox, $"MES TotalWafers: {_report.TotalWafers}", UiBodyText);
                AppendLine(richTextBox, "", UiBodyText);

                var crit = _report.Findings.Count(f => f.Severity == FindingSeverity.Critical);
                var warn = _report.Findings.Count(f => f.Severity == FindingSeverity.Warning);
                var info = _report.Findings.Count(f => f.Severity == FindingSeverity.Info);

                AppendLine(richTextBox, $"Findings: Critical={crit}, Warning={warn}, Info={info}", UiInfo);
                AppendSeparator(richTextBox);
            }

            // Story
            if (includeStory)
            {
                AppendLine(richTextBox, "=== Story ===", UiHeaderText, bold: true);
                AppendLine(richTextBox, _report.ToStory().TrimEnd(), UiBodyText);
                AppendSeparator(richTextBox);
            }

            // Findings
            AppendLine(richTextBox, "=== Findings (Detailed) ===", UiHeaderText, bold: true);

            var ordered = OrderFindings(_report.Findings).ToList();

            int critCount = 0, warnCount = 0, infoCount = 0;

            foreach (var f in ordered)
            {
                if (f.Severity == FindingSeverity.Critical && ++critCount > maxFindingsPerSeverity) continue;
                if (f.Severity == FindingSeverity.Warning && ++warnCount > maxFindingsPerSeverity) continue;
                if (f.Severity == FindingSeverity.Info && ++infoCount > maxFindingsPerSeverity) continue;

                var color = GetColor(f.Severity);
                var icon = GetSeverityIcon(f.Severity);

                AppendLine(richTextBox, $"{icon} [{f.Severity}] {f.Title}", color, bold: true);
                AppendLine(richTextBox, f.Detail, UiBodyText);
                AppendLine(richTextBox, "", UiBodyText);
            }
        }

        // -------------------- THEME APPLY --------------------

        private static void ApplyTextBoxTheme(TextBox tb)
        {
            tb.Multiline = true;
            tb.ScrollBars = ScrollBars.Both;
            tb.WordWrap = false;
            tb.BorderStyle = BorderStyle.None;

            tb.BackColor = UiBackground;
            tb.ForeColor = UiBodyText;
            tb.Font = new Font("Segoe UI", 10f);
        }

        private static void ApplyRichTextBoxTheme(RichTextBox rtb)
        {
            rtb.BackColor = UiBackground;
            rtb.ForeColor = UiBodyText;
            rtb.BorderStyle = BorderStyle.None;
            rtb.Font = new Font("Segoe UI", 10f);
        }

        // -------------------- INTERNAL RENDER HELPERS --------------------

        private static void AppendSeparator(RichTextBox rtb)
        {
            AppendLine(rtb, new string('─', 50), UiSeparator, bold: false);
            AppendLine(rtb, "", UiBodyText);
        }

        private static string RenderFindingsBySeverity(IReadOnlyList<Finding> findings, int maxPerSeverity)
        {
            var sb = new StringBuilder();
            var ordered = OrderFindings(findings).ToList();

            int critCount = 0, warnCount = 0, infoCount = 0;

            foreach (var f in ordered)
            {
                if (f.Severity == FindingSeverity.Critical && ++critCount > maxPerSeverity) continue;
                if (f.Severity == FindingSeverity.Warning && ++warnCount > maxPerSeverity) continue;
                if (f.Severity == FindingSeverity.Info && ++infoCount > maxPerSeverity) continue;

                sb.AppendLine($"{GetSeverityIcon(f.Severity)} [{f.Severity}] {f.Title}");
                sb.AppendLine(f.Detail);
                sb.AppendLine();
            }

            return sb.ToString().TrimEnd();
        }

        private static IEnumerable<Finding> OrderFindings(IReadOnlyList<Finding> findings)
        {
            return findings
                .OrderBy(f => f.Severity switch
                {
                    FindingSeverity.Critical => 0,
                    FindingSeverity.Warning => 1,
                    _ => 2
                })
                .ThenBy(f => f.Title, StringComparer.OrdinalIgnoreCase);
        }

        private static Color GetColor(FindingSeverity sev)
        {
            return sev switch
            {
                FindingSeverity.Critical => UiCritical,
                FindingSeverity.Warning => UiWarning,
                FindingSeverity.Info => UiInfo,
                _ => UiBodyText
            };
        }

        private static string GetSeverityIcon(FindingSeverity sev)
        {
            // Dark UI-friendly icons (no emojis required)
            return sev switch
            {
                FindingSeverity.Critical => "●",
                FindingSeverity.Warning => "▲",
                _ => "■"
            };
        }

        private static void AppendLine(RichTextBox rtb, string text, Color color, bool bold = false)
        {
            var start = rtb.TextLength;
            rtb.AppendText(text + Environment.NewLine);
            var end = rtb.TextLength;

            rtb.Select(start, end - start);
            rtb.SelectionColor = color;

            var current = rtb.SelectionFont ?? rtb.Font;
            rtb.SelectionFont = new Font(current, bold ? FontStyle.Bold : FontStyle.Regular);

            rtb.SelectionLength = 0;
            rtb.SelectionStart = rtb.TextLength;
            rtb.SelectionColor = rtb.ForeColor;
        }
    }
}
