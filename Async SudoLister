    public class SudoLister
    {
        private readonly SSHAuth _auth;
        private readonly string _sudoUser;
        private readonly LogSystem.ILogSystem _logSystem;

        public SudoLister(SSHAuth auth, string sudoUser)
        {
            _auth = auth ?? throw new ArgumentNullException(nameof(auth));
            _sudoUser = string.IsNullOrWhiteSpace(sudoUser) ? throw new ArgumentException("sudoUser required") : sudoUser;
            _logSystem = new LogSystem.LogSystem("Log", "Investigation");
        }

        public SudoLister(SSHAuth auth, string sudoUser, LogSystem.ILogSystem logger)
        {
            _auth = auth ?? throw new ArgumentNullException(nameof(auth));
            _sudoUser = string.IsNullOrWhiteSpace(sudoUser) ? throw new ArgumentException("sudoUser required") : sudoUser;
            _logSystem = logger ?? new LogSystem.LogSystem("Log", "Investigation");
        }

        // ---------- Quoting & clean sudo command ----------
        private static string Q(string s) => "'" + s.Replace("'", "'\"'\"'") + "'";

        /// Build a non-interactive, clean env sudo-bash:
        /// - no ~/.bashrc or ~/.profile (--noprofile --norc)
        /// - TERM=dumb, minimal PATH (avoid stty/tput/TERM errors)
        /// - sudo -n fails fast instead of prompting
        private string BuildSudoCmd(string script)
        {
            const string PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
            var env  = $"env -i TERM=dumb LC_ALL=C PATH={PATH}";
            var bash = "bash --noprofile --norc -lc";
            return $"sudo -n -iu {Q(_sudoUser)} {env} {bash} {Q(script)}";
        }

        // =========================================================================
        // 1) ASYNC LISTING / SEARCH / SUMMARY
        // =========================================================================

        public async Task<List<FileEntry>> ListAsync(string basePath, bool recursive, bool includeFiles = true, bool includeDirs = false)
            => await ExecFindAsync(basePath, recursive, includeFiles, includeDirs);

        public async Task<List<FileEntry>> FindByNameAsync(string basePath, string filename)
        {
            var all = await ExecFindAsync(basePath, recursive: true, includeFiles: true, includeDirs: false);
            return all.Where(f => string.Equals(f.Name, filename, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        public async Task<List<FileEntry>> FindContainingAsync(string basePath, string substring)
        {
            var all = await ExecFindAsync(basePath, recursive: true, includeFiles: true, includeDirs: false);
            return all.Where(f => f.Name.IndexOf(substring, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
        }

        public async Task<Dictionary<string, List<FileEntry>>> SummarizeByNameAsync(string basePath, string filename)
        {
            var matches = await FindByNameAsync(basePath, filename);
            return GroupByDirectory(matches);
        }

        public async Task<Dictionary<string, List<FileEntry>>> SummarizeContainingAsync(string basePath, string substring)
        {
            var matches = await FindContainingAsync(basePath, substring);
            return GroupByDirectory(matches);
        }

