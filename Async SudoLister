        public async Task<TransferRateResult> MeasureTransferRateAsync(
            string basePath, TimeSpan window, bool recursive = true, string? nameContains = null)
        {
            try
            {
                if (window <= TimeSpan.Zero) throw new ArgumentException("window must be > 0", nameof(window));
                var now   = DateTime.Now;
                var start = now - window;

                _logSystem.Info($"MeasureTransferRateAsync start: sudoUser={_sudoUser}, path={basePath}, window={window}, recursive={recursive}, filter={nameContains ?? "-"}");

                var rows = await ExecFindAsync(basePath, recursive, includeFiles: true, includeDirs: false);

                IEnumerable<FileEntry> filtered = rows.Where(f => f.MTime.HasValue && f.MTime.Value >= start && f.MTime.Value <= now);
                if (!string.IsNullOrWhiteSpace(nameContains))
                    filtered = filtered.Where(f => f.Name.Contains(nameContains, StringComparison.OrdinalIgnoreCase));

                int count = filtered.Count();
                var result = new TransferRateResult
                {
                    Files = count,
                    Window = window,
                    WindowStart = start,
                    WindowEnd = now,
                    PerMinute = count / window.TotalMinutes,
                    PerHour   = count / window.TotalHours
                };

                _logSystem.Info($"MeasureTransferRateAsync done: files={result.Files}, perMin={result.PerMinute:F2}, perHour={result.PerHour:F2}");
                return result;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"MeasureTransferRateAsync error: {ex.Message}");
                throw;
            }
        }

        public Task<TransferRateResult> MeasureTransferRateLastMinutesAsync(string basePath, int minutes, bool recursive = true, string? nameContains = null)
            => MeasureTransferRateAsync(basePath, TimeSpan.FromMinutes(minutes), recursive, nameContains);

        public Task<TransferRateResult> MeasureTransferRateLastHoursAsync(string basePath, double hours, bool recursive = true, string? nameContains = null)
            => MeasureTransferRateAsync(basePath, TimeSpan.FromHours(hours), recursive, nameContains);

        public async Task<QueueSizeResult> GetQueueSizeAsync(
            string folderPath,
            bool recursive = false,
            string? nameContains = null,
            bool includeFiles = true,
            bool includeDirs  = false)
        {
            try
            {
                _logSystem.Info(
                    $"GetQueueSizeAsync start: sudoUser={_sudoUser}, path={folderPath}, " +
                    $"recursive={recursive}, filter={nameContains ?? "-"}, " +
                    $"includeFiles={includeFiles}, includeDirs={includeDirs}");

                var rows = await ExecFindAsync(folderPath, recursive, includeFiles, includeDirs);

                IEnumerable<FileEntry> filtered = rows;
                if (!string.IsNullOrWhiteSpace(nameContains))
                    filtered = filtered.Where(f => f.Name.Contains(nameContains, StringComparison.OrdinalIgnoreCase));

                var list = filtered.ToList();
                var result = new QueueSizeResult { Pending = list.Count, Items = list };

                _logSystem.Info($"GetQueueSizeAsync done: pending={result.Pending}");
                if (result.Pending == 0) _logSystem.Warning("GetQueueSizeAsync: no pending items found.");
                return result;
            }
            catch (Exception ex)
            {
                _logSystem.Error($"GetQueueSizeAsync error: {ex.Message}");
                throw;
            }
        }

        public Task<QueueSizeResult> GetQueueSizeFilesOnlyAsync(string path, bool recursive = false, string? nameContains = null)
            => GetQueueSizeAsync(path, recursive, nameContains, includeFiles: true,  includeDirs: false);

        public Task<QueueSizeResult> GetQueueSizeDirsOnlyAsync(string path, bool recursive = false, string? nameContains = null)
            => GetQueueSizeAsync(path, recursive, nameContains, includeFiles: false, includeDirs: true);

        public Task<QueueSizeResult> GetQueueSizeFilesAndDirsAsync(string path, bool recursive = false, string? nameContains = null)
            => GetQueueSizeAsync(path, recursive, nameContains, includeFiles: true,  includeDirs: true);

        // =========================================================================
        // 3) ASYNC COPY: REMOTE → LOCAL  (sudo cat)
        // =========================================================================
        public async Task CopyFileFromRemoteAsync(string remotePath, string localPath)
        {
            var catCmd = BuildSudoCmd($"cat {remotePath}");
            try
            {
                _logSystem.Info($"CopyFileFromRemoteAsync start: sudoUser={_sudoUser}, remote={remotePath}, local={localPath}");

                await Task.Run(() =>
                {
                    using var ssh = CreateSsh(_auth);
                    ssh.Connect();
                    var cmd = ssh.CreateCommand(catCmd);
                    using var output = cmd.ExecuteReader(); // raw bytes

                    Directory.CreateDirectory(Path.GetDirectoryName(localPath) ?? ".");
                    using var fs = new FileStream(localPath, FileMode.Create, FileAccess.Write, FileShare.None);
                    output.BaseStream.CopyTo(fs);
                    ssh.Disconnect();
                });

                _logSystem.Info($"CopyFileFromRemoteAsync done: {remotePath} -> {localPath}");
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CopyFileFromRemoteAsync error ({remotePath}): {ex.Message}");
                throw;
            }
        }

        // =========================================================================
        // 4) ASYNC COPY: LOCAL → REMOTE  (SFTP to /tmp + sudo mv + chmod/chown)
        // =========================================================================
        public async Task CopyFileToRemoteAsync(string localPath, string remotePath, string? chmod = null, string? chown = null)
        {
            if (!File.Exists(localPath)) throw new FileNotFoundException("Local file not found", localPath);

            var tempName   = $"upload_{Guid.NewGuid():N}";
            var tempRemote = $"/tmp/{tempName}";

            try
            {
                _logSystem.Info($"CopyFileToRemoteAsync start: sudoUser={_sudoUser}, local={localPath}, remote={remotePath}, chmod={chmod ?? "-"}, chown={chown ?? "-"}");

                // 1) Upload to temp via SFTP (login user)
                await Task.Run(() =>
                {
                    using var sftp = CreateSftp(_auth);
                    sftp.Connect();
                    using var lf = new FileStream(localPath, FileMode.Open, FileAccess.Read, FileShare.Read);
                    sftp.UploadFile(lf, tempRemote);
                    sftp.Disconnect();
                });

                // 2) sudo move to final + optional chmod/chown
                var destDir = $"$(dirname {Q(remotePath)})";
                string script = $"mkdir -p {destDir} && mv {Q(tempRemote)} {Q(remotePath)}";
                if (!string.IsNullOrWhiteSpace(chmod)) script += $" && chmod {chmod} {Q(remotePath)}";
                if (!string.IsNullOrWhiteSpace(chown)) script += $" && chown {chown} {Q(remotePath)}";
                var fullCmd = BuildSudoCmd(script);

                await Task.Run(() =>
                {
                    using var ssh = CreateSsh(_auth);
                    ssh.Connect();
                    var cmd = ssh.CreateCommand(fullCmd);
                    var res = cmd.Execute();
                    var exit = cmd.ExitStatus;
                    var err  = cmd.Error;
                    ssh.Disconnect();
                    if (exit != 0) throw new Exception($"sudo move failed (exit {exit}). Error: {err}");
                });

                _logSystem.Info($"CopyFileToRemoteAsync done: {localPath} -> {remotePath}");
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CopyFileToRemoteAsync error ({localPath} -> {remotePath}): {ex.Message}");
                // optional cleanup (best-effort)
                try
                {
                    await Task.Run(() =>
                    {
                        using var ssh = CreateSsh(_auth);
                        ssh.Connect();
                        var cleanup = ssh.CreateCommand(BuildSudoCmd($"rm -f {Q(tempRemote)}"));
                        cleanup.Execute();
                        ssh.Disconnect();
                    });
                }
                catch { /* ignore */ }
                throw;
            }
        }

        // =========================================================================
        // 5) ASYNC: CHECK CRONTAB
        // =========================================================================
        public async Task<CrontabResult> CheckCrontabExistsAsync()
        {
            try
            {
                _logSystem.Info($"CheckCrontabExistsAsync start: sudoUser={_sudoUser}");

                // Use sh to avoid .profile-ebs; keep clean env
                var cmdText = $"sudo -n -iu {_sudoUser} env -i TERM=dumb LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin sh -c 'crontab -l 2>&1'";

                var (output, exit) = await RunWithExitAsync(cmdText);

                var lines = output
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .ToList();

                // Filter banners if any
                lines.RemoveAll(l =>
                    l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                    l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase)
                );

                var cleanOutput = string.Join("\n", lines);

                if (exit == 0 && lines.Count > 0)
                {
                    var entries = lines.Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
                    _logSystem.Info($"Crontab found for {_sudoUser}: {entries.Count} lines");
                    return new CrontabResult { Exists = true, Entries = entries, RawOutput = cleanOutput };
                }

                if (cleanOutput.Contains("no crontab for", StringComparison.OrdinalIgnoreCase))
                {
                    _logSystem.Warning($"No crontab for {_sudoUser}");
                    return new CrontabResult { Exists = false, RawOutput = cleanOutput };
                }

                if (exit != 0)
                {
                    _logSystem.Error($"CheckCrontabExistsAsync failed (exit {exit}): {cleanOutput}");
                    throw new Exception($"Unexpected error while checking crontab: {cleanOutput}");
                }

                _logSystem.Warning($"CheckCrontabExistsAsync ambiguous: output={cleanOutput}");
                return new CrontabResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckCrontabExistsAsync error: {ex.Message}");
                throw;
            }
        }

        // =========================================================================
        // 6) ASYNC: PROCESS SNAPSHOT / GREP / TOP
        // =========================================================================
        public async Task<ProcessResult> CheckProcessListAsync(string? filter = null)
        {
            try
            {
                _logSystem.Info($"CheckProcessListAsync start: sudoUser={_sudoUser}, filter={filter ?? "-"}");

                var psLines = await GetCleanProcessSnapshotAsync(out var rawPs);

                if (!string.IsNullOrWhiteSpace(filter))
                    psLines = psLines.Where(l => l.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();

                var cleanOutput = string.Join("\n", psLines);

                if (psLines.Count > 0)
                {
                    _logSystem.Info($"CheckProcessListAsync done: {psLines.Count} processes (filter={filter ?? "none"})");
                    return new ProcessResult { Exists = true, Entries = psLines, RawOutput = cleanOutput };
                }

                _logSystem.Warning($"No processes found (filter={filter ?? "none"})");
                return new ProcessResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckProcessListAsync error: {ex.Message}");
                throw;
            }
        }

        public async Task<TopResult> CheckTopProcessesAsync(int topCount = 10)
        {
            try
            {
                _logSystem.Info($"CheckTopProcessesAsync start: sudoUser={_sudoUser}, topCount={topCount}");

                string script = "top -b -n 1 2>&1";
                var cmdText = BuildSudoCmd(script);
                var (output, exit) = await RunWithExitAsync(cmdText);

                var lines = output
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .ToList();

                // Remove banner noise
                lines.RemoveAll(l =>
                    l.StartsWith("EBS instance:", StringComparison.OrdinalIgnoreCase) ||
                    l.StartsWith("Sourcing ", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains(".profile-ebs", StringComparison.OrdinalIgnoreCase) ||
                    l.Contains("successfully loaded", StringComparison.OrdinalIgnoreCase)
                );

                var cleanOutput = string.Join("\n", lines);

                int startIdx = lines.FindIndex(l => l.StartsWith("PID "));
                var topLines = (startIdx >= 0)
                    ? lines.Skip(startIdx + 1).Take(topCount).ToList()
                    : lines.TakeLast(topCount).ToList();

                if (exit == 0 && topLines.Count > 0)
                {
                    _logSystem.Info($"CheckTopProcessesAsync done: {topLines.Count} top entries.");
                    return new TopResult { Exists = true, TopEntries = topLines, RawOutput = cleanOutput };
                }

                _logSystem.Warning($"No top processes found.");
                return new TopResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckTopProcessesAsync error: {ex.Message}");
                throw;
            }
        }

        public async Task<ProcessResult> CheckProcessByNameAsync(string processName)
        {
            try
            {
                _logSystem.Info($"CheckProcessByNameAsync start: sudoUser={_sudoUser}, process={processName}");

                var psLines = await GetCleanProcessSnapshotAsync(out var rawPs);
                var lines = psLines
                    .Where(l => !l.Contains("grep -i", StringComparison.OrdinalIgnoreCase))
                    .Where(l => l.IndexOf(processName, StringComparison.OrdinalIgnoreCase) >= 0)
                    .ToList();

                var cleanOutput = string.Join("\n", lines);

                if (lines.Count > 0)
                {
                    _logSystem.Info($"Process '{processName}' found: {lines.Count} entries");
                    return new ProcessResult { Exists = true, Entries = lines, RawOutput = cleanOutput };
                }

                _logSystem.Warning($"Process '{processName}' not found.");
                return new ProcessResult { Exists = false, RawOutput = cleanOutput };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckProcessByNameAsync error ({processName}): {ex.Message}");
                throw;
            }
        }

        public async Task<MultiProcessResult> CheckProcessesByNamesAsync(IEnumerable<string> processNames)
        {
            try
            {
                var names = processNames?.Where(n => !string.IsNullOrWhiteSpace(n)).ToList() ?? new List<string>();
                if (names.Count == 0) throw new ArgumentException("At least one process name must be provided.", nameof(processNames));

                _logSystem.Info($"CheckProcessesByNamesAsync start: sudoUser={_sudoUser}, count={names.Count}");

                var psLines = await GetCleanProcessSnapshotAsync(out var rawPs);
                var lowerPs = psLines
                    .Where(l => !l.Contains("grep -i", StringComparison.OrdinalIgnoreCase))
                    .Select(l => (orig: l, low: l.ToLowerInvariant()))
                    .ToList();

                var results = new Dictionary<string, ProcessResult>(StringComparer.OrdinalIgnoreCase);
                var missing = new List<string>();

                foreach (var name in names)
                {
                    var needle = name.ToLowerInvariant();
                    var matches = lowerPs.Where(x => x.low.Contains(needle)).Select(x => x.orig).ToList();

                    if (matches.Count > 0)
                    {
                        _logSystem.Info($"Process '{name}' found: {matches.Count} matches");
                        results[name] = new ProcessResult { Exists = true, Entries = matches, RawOutput = string.Join("\n", matches) };
                    }
                    else
                    {
                        _logSystem.Warning($"Process '{name}' not found.");
                        results[name] = new ProcessResult { Exists = false, Entries = new List<string>(), RawOutput = "" };
                        missing.Add(name);
                    }
                }

                return new MultiProcessResult
                {
                    Results = results,
                    AllFound = missing.Count == 0,
                    Missing = missing,
                    RawPsOutput = rawPs
                };
            }
            catch (Exception ex)
            {
                _logSystem.Error($"CheckProcessesByNamesAsync error: {ex.Message}");
                throw;
            }
        }

        public async Task<MultiProcessResult> CheckProcessesByMapAsync(IDictionary<string, string> labelToPattern)
        {
            if (labelToPattern == null || labelToPattern.Count == 0)
                throw new ArgumentException("labelToPattern must contain at least one entry.", nameof(labelToPattern));

            _logSystem.Info($"CheckProcessesByMapAsync start: sudoUser={_sudoUser}, count={labelToPattern.Count}");

            var psLines = await GetCleanProcessSnapshotAsync(out var rawPs);
            var lowerPs = psLines
                .Where(l => !l.Contains("grep -i", StringComparison.OrdinalIgnoreCase))
                .Select(l => (orig: l, low: l.ToLowerInvariant()))
                .ToList();

            var results = new Dictionary<string, ProcessResult>(StringComparer.OrdinalIgnoreCase);
            var missing = new List<string>();

            foreach (var kv in labelToPattern)
            {
                var label = kv.Key ?? "";
                var pattern = kv.Value ?? "";
                var needle = pattern.ToLowerInvariant();

                var matches = lowerPs.Where(x => x.low.Contains(needle)).Select(x => x.orig).ToList();

                if (matches.Count > 0)
                {
                    _logSystem.Info($"Process '{label}' (pattern '{pattern}') found: {matches.Count} matches");
                    results[label] = new ProcessResult { Exists = true, Entries = matches, RawOutput = string.Join("\n", matches) };
                }
                else
                {
                    _logSystem.Warning($"Process '{label}' (pattern '{pattern}') not found.");
                    results[label] = new ProcessResult { Exists = false, Entries = new List<string>(), RawOutput = "" };
                    missing.Add(label);
                }
            }

            return new MultiProcessResult
            {
                Results = results,
                AllFound = missing.Count == 0,
                Missing = missing,
                RawPsOutput = rawPs
            };
        }

