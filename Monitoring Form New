private void SetDiskUsageUI(
    Label labelTotal,
    Label labelMount,
    Label labelPercent,
    string size,          // e.g. "900G"
    string mountedOn,     // e.g. "/srv/ebsdba"
    string filesystem,    // e.g. "/dev/sda1"
    string usePercent,    // e.g. "45%"
    string used,          // e.g. "405G"
    ProgressBar progressBar = null)
{
    // ---------------- Base text ----------------
    labelTotal.Text = $"Total: {size ?? "-"}   Used: {used ?? "-"}";
    labelMount.Text = $"Mount: {mountedOn ?? "-"}";
    labelTotal.ForeColor = Flat47Style.TextPrimary;
    labelMount.ForeColor = Flat47Style.TextPrimary;

    // ---------------- Parse percentage ----------------
    int percentValue = -1;
    if (!string.IsNullOrWhiteSpace(usePercent))
    {
        var cleaned = usePercent.Replace("%", "").Trim();
        int.TryParse(cleaned, out percentValue);
    }

    // ---------------- Usage text ----------------
    labelPercent.Text = percentValue >= 0
        ? $"Usage: {percentValue}%  ({filesystem ?? "unknown"})"
        : $"Usage: {usePercent ?? "-"}";

    // ---------------- Threshold colors ----------------
    Color usageColor;

    if (percentValue < 0)
    {
        usageColor = Flat47Style.TextMuted;
    }
    else if (percentValue >= 90)
    {
        usageColor = Color.IndianRed;   // 🔴 Critical
    }
    else if (percentValue >= 80)
    {
        usageColor = Color.Khaki;       // 🟡 Warning
    }
    else
    {
        usageColor = Color.LimeGreen;   // ✅ Healthy
    }

    labelPercent.ForeColor = usageColor;

    // ---------------- Optional ProgressBar ----------------
    if (progressBar != null)
    {
        progressBar.Minimum = 0;
        progressBar.Maximum = 100;
        progressBar.Value = Math.Max(0, Math.Min(100, percentValue < 0 ? 0 : percentValue));

        progressBar.BackColor = Flat47Style.SurfaceAlt;
        progressBar.ForeColor = usageColor;
    }

    // ---------------- Optional: tooltip for quick glance ----------------
    var tooltipText =
        $"Filesystem : {filesystem}\n" +
        $"Mounted on : {mountedOn}\n" +
        $"Used       : {used}\n" +
        $"Total      : {size}\n" +
        $"Usage      : {usePercent}";

    var tip = new ToolTip();
    tip.SetToolTip(labelPercent, tooltipText);
    tip.SetToolTip(labelTotal, tooltipText);
}
