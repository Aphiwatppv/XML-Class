namespace BKGEBSInvestigation.WTUserController
{
    public partial class CheckStatusController : UserControl
    {
        // External engines
        private SudoLister.EngineSudo.SudoLister _sudoListerEBSO;
        private SudoLister.EngineSudo.SudoLister _sudoListerEBSA;

        // Progress channels
        private readonly Progress<ReportStatusEBSAProgress> _progressEBSA;
        private readonly Progress<ReportStatusEBSOProgress> _progressEBSO;

        // Core engine + config
        private readonly ICheckingStatusEngine _checkingStatusEngine;
        private readonly XmlConfigManager _xmlConfigManager;

        // Cached crontab lines
        private List<string> _listlineEBSO = new List<string>();
        private List<string> _listlineEBSA = new List<string>();
        private List<string> _listlineEBSOXe1 = new List<string>();
        private List<string> _listlineEBSOXe2 = new List<string>();

        // Bottom StatusStrip (created in code)
        private StatusStrip _statusStrip;
        private ToolStripStatusLabel _statusText;
        private ToolStripStatusLabel _statusSpacer;
        private ToolStripProgressBar _statusProgress;

        // Status pulse state
        private string _lastStableStatus = "Ready";
        private CancellationTokenSource _pulseCts;

        public CheckStatusController() : this(null, null) { }

        public CheckStatusController(XmlConfigManager xmlConfigManager, ICheckingStatusEngine engine)
        {
            InitializeComponent();

            // Progress channels on UI thread
            _progressEBSA = new Progress<ReportStatusEBSAProgress>();
            _progressEBSO = new Progress<ReportStatusEBSOProgress>();
            _progressEBSA.ProgressChanged += ProgressEBSA_ProgressChanged;
            _progressEBSO.ProgressChanged += ProgressEBSO_ProgressChanged;

            _xmlConfigManager = xmlConfigManager ?? new XmlConfigManager();
            _checkingStatusEngine = engine ?? new CheckingStatusEngine(_progressEBSA, _progressEBSO, _xmlConfigManager);

            // Bottom strip + style
            BuildStatusUI();
            Flat47Style.ApplyToControlTree(this);
            Flat47Style.StyleStatusStrip(_statusStrip);

            // Initial button state
            buttonCrontabA.Enabled = false;
            buttonCrontabO.Enabled = false;
            buttonCrontabOXe1.Enabled = false;
            buttonCrontabOXe2.Enabled = false;

            StopProgress("Ready");
            WireStatusPulses();

            // Initial crontab status labels (repurposed from badges)
            _badgeEBSO.Text = "Crontab: —";
            _badgeEBSA.Text = "Crontab: —";
            _badgeEBSOXe1.Text = "Crontab: —";
            _badgeEBSOXe2.Text = "Crontab: —";

            _ = StartCheckingEngine();
        }

        // ----------------------- StatusStrip -------------------------
        private void BuildStatusUI()
        {
            _statusStrip = new StatusStrip
            {
                SizingGrip = false,
                Dock = DockStyle.Bottom,
                BackColor = Color.FromArgb(25, 25, 25),
                ForeColor = Color.Gainsboro,
                RenderMode = ToolStripRenderMode.System
            };

            _statusText = new ToolStripStatusLabel("Ready")
            {
                Spring = false,
                ForeColor = Color.Gainsboro
            };

            _statusSpacer = new ToolStripStatusLabel { Spring = true, Text = string.Empty };

            _statusProgress = new ToolStripProgressBar
            {
                Visible = false,
                Minimum = 0,
                Maximum = 100,
                Value = 0,
                Style = ProgressBarStyle.Continuous,
                AutoSize = false,
                Width = 160
            };

            _statusStrip.Items.Add(_statusText);
            _statusStrip.Items.Add(_statusSpacer);
            _statusStrip.Items.Add(new ToolStripControlHost(new Panel { Width = 4 }));
            _statusStrip.Items.Add(_statusProgress);

            Controls.Add(_statusStrip);
            _statusStrip.BringToFront();
        }

        private void UpdateStatus(string text, bool isError = false, bool persist = true)
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => UpdateStatus(text, isError, persist))); return; }
            _statusText.Text = text ?? string.Empty;
            _statusText.ForeColor = isError ? Color.IndianRed : Flat47Style.TextPrimary;
            if (!isError && persist) _lastStableStatus = _statusText.Text;
        }

        private void StartProgress(string text = "Working…", bool marquee = true)
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => StartProgress(text, marquee))); return; }
            UpdateStatus(text, false, persist: true);
            _statusProgress.Visible = true;
            _statusProgress.Value = 0;
            _statusProgress.Style = marquee ? ProgressBarStyle.Marquee : ProgressBarStyle.Continuous;
            _statusProgress.MarqueeAnimationSpeed = marquee ? 30 : 0;
        }

        private void StopProgress(string text = "Ready")
        {
            if (InvokeRequired) { BeginInvoke(new Action(() => StopProgress(text))); return; }
            _statusProgress.Visible = false;
            _statusProgress.MarqueeAnimationSpeed = 0;
            UpdateStatus(text, false, persist: true);
        }

        private void ShowError(string msg)
        {
            UpdateStatus(msg, isError: true, persist: false);
            MessageBox.Show(this, msg, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }

        private void SetBusy(bool busy)
        {
            Cursor = busy ? Cursors.WaitCursor : Cursors.Default;
            RefreshBtn.Enabled = !busy;
            buttonProcessEBSO.Enabled = !busy;
            buttonProcessEBSA.Enabled = !busy;

            if (busy) StartProgress("Running…", marquee: true);
            else StopProgress("Ready");
        }

        // ----------------------- Pulse -------------------------
        private void WireStatusPulses()
        {
            RefreshBtn.MouseEnter += (_, __) => _ = PulseAsync("Refresh system status…");
            buttonProcessEBSO.MouseEnter += (_, __) => _ = PulseAsync("View processes in EBSO…");
            buttonProcessEBSA.MouseEnter += (_, __) => _ = PulseAsync("View processes in EBSA…");

            buttonCrontabO.MouseEnter += (_, __) => _ = PulseAsync("Open EBSO crontab…");
            buttonCrontabA.MouseEnter += (_, __) => _ = PulseAsync("Open EBSA crontab…");
            buttonCrontabOXe1.MouseEnter += (_, __) => _ = PulseAsync("Open EBSO Xe1 crontab…");
            buttonCrontabOXe2.MouseEnter += (_, __) => _ = PulseAsync("Open EBSO Xe2 crontab…");
        }

        private async Task PulseAsync(string message, int durationMs = 800)
        {
            try
            {
                _pulseCts?.Cancel();
                _pulseCts = new CancellationTokenSource();

                UpdateStatus(message, isError: false, persist: false);
                await Task.Delay(durationMs, _pulseCts.Token);

                UpdateStatus(_lastStableStatus, isError: false, persist: false);
            }
            catch (TaskCanceledException) { }
        }

        // --------------------------- Engine ---------------------------
        public async Task StartCheckingEngine()
        {
            try
            {
                SetBusy(true);
                StartProgress("Checking system status…", marquee: true);
                await _checkingStatusEngine.StartEngine().ConfigureAwait(true);
                StopProgress("Status updated");
            }
            catch (Exception ex)
            {
                ShowError("Engine error: " + ex.Message);
            }
            finally
            {
                SetBusy(false);
            }
        }

        // ----------------------- Progress Handlers ---------------------------
        private void ProgressEBSO_ProgressChanged(object sender, ReportStatusEBSOProgress e)
        {
            if (e == null) return;
            if (InvokeRequired) { BeginInvoke(new Action(() => ProgressEBSO_ProgressChanged(sender, e))); return; }

            labelEBSOPathError.Text = e.PathEBSOerrorlabel ?? "Path: -";
            labelEBSOPathInput.Text = e.PathEBSOinputlabel ?? "Path: -";
            labelEBSOPathInWork.Text = e.PathEBSOIn_worklabel ?? "Path: -";
            labelEBSOPathPool.Text = e.PathEBSOTranferPoollabel ?? "Path: -";

            SetCount(countEBSOTranferPoollabel, e.countEBSOTranferPoollabel);
            SetCount(countEBSOerrorlabel, e.countEBSOerrorlabel);
            SetCount(countEBSOinputlabel, e.countEBSOinputlabel);
            SetCount(countEBSOIn_worklabel, e.countEBSOIn_worklabel);

            SetStatusLabel(labelPoolStatusEBSO, e.EBSOTranferPoollabel);
            SetStatusLabel(labelStatusInworkEBSO, e.EBSOIn_worklabel);
            SetStatusLabel(labelStatusInputEBSO, e.EBSOinputlabel);
            SetStatusLabel(labelStatusErrorEBSO, e.EBSOerrorlabel);

            // Disk UI (extended)
            SetDiskUsageUI(
                labelEBSOTotalDisk,
                labelEBSOMPoint,
                labelPercentageUsageEBSO,
                e.Size,
                e.MountedOn,
                e.Filesystem,
                e.UsePercent,
                e.Used,
                progressBarDiskEBSO
            );

            // Crontab status labels (repurposed badges)
            UpdateCrontabUI(e.Exists, e.Entries, panelEBSOCrontab, buttonCrontabO,
                ref _listlineEBSO, e.EBSOCrontabStatus, _badgeEBSO);

            UpdateCrontabUI(e.Xe1Exists, e.Xe1Entries, panelEBSOXe1Crontab, buttonCrontabOXe1,
                ref _listlineEBSOXe1, e.EBSOXe1CrontabStatus, _badgeEBSOXe1);

            UpdateCrontabUI(e.Xe2Exists, e.Xe2Entries, panelEBSOXe2Crontab, buttonCrontabOXe2,
                ref _listlineEBSOXe2, e.EBSOXe2CrontabStatus, _badgeEBSOXe2);

            UpdateStatus("EBSO status refreshed", persist: true);
        }

        private void ProgressEBSA_ProgressChanged(object sender, ReportStatusEBSAProgress e)
        {
            if (e == null) return;
            if (InvokeRequired) { BeginInvoke(new Action(() => ProgressEBSA_ProgressChanged(sender, e))); return; }

            labelEBSAPathError.Text = e.PathEBSAerrorlabel ?? "Path: -";
            labelEBSAPathInput.Text = e.PathEBSAinputlabel ?? "Path: -";
            labelEBSAPathInWork.Text = e.PathEBSAIn_worklabel ?? "Path: -";

            SetCount(countEBSAerrorlabel, e.countEBSAerrorlabel);
            SetCount(countEBSAinputlabel, e.countEBSAinputlabel);
            SetCount(countEBSAIn_worklabel, e.countEBSAIn_worklabel);

            SetStatusLabel(labelStatusErrorEBSA, e.EBSAerrorlabel);
            SetStatusLabel(labelStatusInputEBSA, e.EBSAinputlabel);
            SetStatusLabel(labelStatusInworkEBSA, e.EBSAIn_worklabel);

            // If your EBSA progress has disk fields too, use it here.
            // If not, keep placeholders.
            if (!string.IsNullOrWhiteSpace(e.UsePercent) || !string.IsNullOrWhiteSpace(e.Size))
            {
                SetDiskUsageUI(
                    labelEBSATotalDisk,
                    labelEBSAMPoint,
                    labelPercentageUsageEBSA,
                    e.Size,
                    e.MountedOn,
                    e.Filesystem,
                    e.UsePercent,
                    e.Used,
                    progressBarDiskEBSA
                );
            }

            UpdateCrontabUI(e.Exists, e.Entries, panelEBSACrontab, buttonCrontabA,
                ref _listlineEBSA, e.EBSACrontabStatus, _badgeEBSA);

            UpdateStatus("EBSA status refreshed", persist: true);
        }

        // ----------------------------- UI Utils ------------------------------
        private static void SetCount(Label label, int value)
        {
            label.Text = $"{value} files";
        }

        private static void SetStatusLabel(Label label, string status)
        {
            status ??= "-";
            label.Text = "STATUS: " + status;
            label.ForeColor = string.Equals(status, "Finished...", StringComparison.OrdinalIgnoreCase)
                ? Color.LimeGreen
                : Color.Khaki;
        }

        // Crontab status label (checking / finished / missing)
        private static void UpdateCrontabUI(
            bool exists,
            List<string> entries,
            Panel panel,
            Button button,
            ref List<string> backingStore,
            string status,
            Label labelStatus)
        {
            entries ??= new List<string>();
            backingStore = exists ? new List<string>(entries) : new List<string>();

            panel.BackColor = exists ? Flat47Style.Surface : Flat47Style.SurfaceAlt;
            button.Enabled = exists;

            string norm = (status ?? "").Trim().ToLowerInvariant();
            string text;
            Color color;

            if (!exists)
            {
                text = "Crontab: missing";
                color = Color.IndianRed;
            }
            else if (norm.Contains("start") || norm.Contains("checking"))
            {
                text = "Crontab: checking…";
                color = Color.Khaki;
            }
            else if (norm.Contains("finished"))
            {
                text = $"Crontab: finished ({entries.Count} line{(entries.Count == 1 ? "" : "s")})";
                color = Color.LimeGreen;
            }
            else
            {
                text = "Crontab: " + (status ?? "ready");
                color = Flat47Style.TextPrimary;
            }

            labelStatus.Text = text;
            labelStatus.ForeColor = color;
        }

        // Disk usage UI (extended signature)
        private void SetDiskUsageUI(
            Label labelTotal,
            Label labelMount,
            Label labelPercent,
            string size,
            string mountedOn,
            string filesystem,
            string usePercent,
            string used,
            ProgressBar progressBar = null)
        {
            filesystem ??= "-";
            mountedOn ??= "-";
            size ??= "-";
            used ??= "-";
            usePercent ??= "-";

            // parse "45%" -> 45
            int percentValue = -1;
            if (!string.IsNullOrWhiteSpace(usePercent))
            {
                var cleaned = usePercent.Replace("%", "").Trim();
                int.TryParse(cleaned, out percentValue);
            }

            labelMount.Text = $"FS: {filesystem}   Mount: {mountedOn}";
            labelTotal.Text = $"Used: {used} / {size}";
            labelPercent.Text = percentValue >= 0 ? $"{percentValue}%" : usePercent;

            Color usageColor;
            if (percentValue < 0) usageColor = Flat47Style.TextMuted;
            else if (percentValue >= 90) usageColor = Color.IndianRed;
            else if (percentValue >= 80) usageColor = Color.Khaki;
            else usageColor = Color.LimeGreen;

            labelPercent.ForeColor = usageColor;

            if (progressBar != null)
            {
                progressBar.Value = Math.Max(0, Math.Min(100, percentValue < 0 ? 0 : percentValue));
            }
        }

