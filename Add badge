private static void UpdateCrontabUI(
    bool exists,
    List<string> entries,
    Panel panel,
    Button button,
    ref List<string> backingStore,
    string status,
    Label labelStatus)
{
    entries ??= new List<string>();
    backingStore = exists ? new List<string>(entries) : new List<string>();

    // Style base colors
    panel.BackColor = exists ? Flat47Style.Surface : Flat47Style.SurfaceAlt;
    button.Enabled  = exists;
    if (exists) Flat47Style.StyleButton(button);

    // Determine state
    string norm = (status ?? "").Trim().ToLowerInvariant();
    string displayText = "—";
    Color textColor = Flat47Style.TextMuted;

    if (!exists)
    {
        displayText = "Crontab missing";
        textColor = Color.IndianRed;
    }
    else if (norm.Contains("start") && norm.Contains("crontab"))
    {
        displayText = "Checking Crontab...";
        textColor = Color.Khaki; // Yellow for active checking
    }
    else if (norm.Contains("finished"))
    {
        displayText = $"Finished checking ({entries.Count} job{(entries.Count == 1 ? "" : "s")})";
        textColor = Color.LimeGreen; // ✅ Green for finished
    }
    else
    {
        displayText = status ?? "Ready";
        textColor = Flat47Style.TextPrimary;
    }

    // Apply to label
    labelStatus.Text = displayText;
    labelStatus.ForeColor = textColor;
}
